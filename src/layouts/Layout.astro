---
import MobileTabBar from '../components/layout/MobileTabBar.astro';
import Toast from '../components/ui/Toast.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeTab?: 'home' | 'library' | 'search' | 'archive';
}

const {
  title,
  description = '每日一影院 — 每天一张电影票，触发观影欲望',
  image,
  activeTab,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="每日一电影 RSS" href="/rss.xml" />
    <link rel="stylesheet" href="/styles/anthropic-theme.css" />
    <link rel="preload" href="/logo.png" as="image" />
    <link rel="preload" href="/fallback-poster.svg" as="image" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content="每日一电影" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <title>{title} | 每日一电影</title>
    <meta name="view-transition" content="same-origin" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': '每日一影院',
      'alternateName': 'Daily Movie',
      'url': 'https://daily-movie.jiahongw.com',
      'description': '每日推荐一部经典电影',
      'inLanguage': 'zh-CN'
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">跳到主要内容</a>
    <div id="main" class="page-wrapper">
      <nav class="global-navbar" role="navigation" aria-label="主-navigation">
        <a href="/" class="logo">
          <img src="/logo.png" alt="每日电影" width="36" height="36" />
          <span>每日电影</span>
        </a>
        <div class="nav-links">
          <a href="/" class:list={[{ 'active': activeTab === 'home' }]}>首页</a>
          <a href="/library/" class:list={[{ 'active': activeTab === 'library' }]}>电影库</a>
          <a href="/search/" class:list={[{ 'active': activeTab === 'search' }]}>搜索</a>
          <a href="/archive/" class:list={[{ 'active': activeTab === 'archive' }]}>归档</a>
          <button
          id="theme-toggle"
          class="theme-toggle"
          aria-label="切换主题"
          title="切换日间/暗色模式"
        >
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
          <a href="/rss.xml" class="rss-link" title="订阅 RSS" aria-label="RSS 订阅">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </a>
        </div>
      </nav>
      <main class="page-content">
        <slot />
      </main>
      <MobileTabBar />
      <Toast />
      <footer class="global-footer">
        <div class="footer-inner">
          <span>每日电影 © 2026</span>
          <div class="footer-links">
            <a href="/rss.xml">RSS</a>
            <a href="https://github.com/redisread/daily-movie" target="_blank" rel="noopener">GitHub</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
  <script>
    // Theme switching
    const THEME_KEY = 'daily-movie-theme';
    const stored = localStorage.getItem(THEME_KEY);
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = stored || (systemDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', current);

    const toggle = document.getElementById('theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.getAttribute('data-theme') === 'dark';
        const next = isDark ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem(THEME_KEY, next);
      });
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 'Escape') {
        document.querySelectorAll('dialog[open]').forEach(d => (d as HTMLDialogElement).close());
      }
    });

    // Service Worker registration for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</html>

<style is:global>

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Links — inherited from CSS variables in theme */

  a {
    color: var(--link);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  a:hover {
    color: var(--accent-hover);
  }

  /* Focus visible for accessibility */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Skip to content link */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 8px;
    background: var(--accent);
    color: var(--bg-primary) !important;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: 600;
    z-index: 9999;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 8px;
  }

  /* Fade-in animation for page load */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Stagger animation for cards */
  @keyframes staggerIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Skeleton loading animation */
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .skeleton {
    background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-secondary) 50%, var(--bg-card) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--radius);
  }

  /* Page wrapper */
  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    flex: 1;
    padding-bottom: 0;
  }

  /* Cinema mode removed — everything uses the ticket design now */

  @media (max-width: 640px) {
    .page-content {
      padding-bottom: 60px;
    }
  }

  /* Global navbar */
  .global-navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    border-bottom: 2px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(250, 248, 244, 0.85);
    position: sticky;
    top: 0;
    z-index: 999;
  }

  [data-theme="dark"] .global-navbar {
    background: rgba(19, 16, 13, 0.85);
  }

  .global-navbar .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary) !important;
  }

  .global-navbar .logo img {
    width: 36px;
    height: 36px;
    border-radius: 8px;
  }

  .global-navbar .logo span {
    font-size: 1.1rem;
  }

  .global-navbar .logo:hover {
    color: var(--accent) !important;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a.active {
    color: var(--accent);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .theme-toggle .icon-sun { display: none; }
  .theme-toggle .icon-moon { display: block; }

  [data-theme="dark"] .theme-toggle .icon-sun { display: block; }
  [data-theme="dark"] .theme-toggle .icon-moon { display: none; }

  .nav-links a:hover {
    color: var(--accent) !important;
  }

  .rss-link {
    display: flex;
    align-items: center;
    color: var(--accent) !important;
  }

  .rss-link:hover {
    color: var(--accent-hover) !important;
  }

  /* Global footer */
  .global-footer {
    border-top: 1px solid var(--border);
    padding: 32px 24px;
    margin-top: 80px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--accent) !important;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }

  /* View Transitions */
  @view-transition {
    navigation: auto;
  }

  /* Safe area insets */
  body {
    padding-top: env(safe-area-inset-top, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* ========== Navbar responsive ========== */
  @media (max-width: 720px) {
    .global-navbar {
      padding: 12px 16px;
    }

    .nav-links a:not(.rss-link):not(#theme-toggle) {
      display: none;
    }

    .nav-links {
      gap: 12px;
    }

    .nav-links a.active {
      border-bottom: none;
      padding-bottom: 0;
    }

    .global-navbar .logo span {
      font-size: 1rem;
    }
  }

  @media (max-width: 360px) {
    .global-navbar {
      padding: 10px 12px;
    }
    .nav-links {
      gap: 8px;
    }
  }
</style>
