---
import MobileTabBar from '../components/layout/MobileTabBar.astro';
import Toast from '../components/ui/Toast.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeTab?: 'home' | 'library' | 'search' | 'archive';
}

const {
  title,
  description = '每日一影院 — 每天一张电影票，触发观影欲望',
  image,
  activeTab,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="每日一电影 RSS" href="/rss.xml" />
    <link rel="stylesheet" href="/styles/anthropic-theme.css" />
    <link rel="preload" href="/logo.png" as="image" />
    <link rel="preload" href="/fallback-poster.svg" as="image" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content="每日一电影" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <title>{title} | 每日一电影</title>
    <meta name="view-transition" content="same-origin" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': '每日一影院',
      'alternateName': 'Daily Movie',
      'url': 'https://daily-movie.jiahongw.com',
      'description': '每日推荐一部经典电影',
      'inLanguage': 'zh-CN'
    })} />
  </head>
  <body class="scanlines">
    <a href="#main" class="skip-link">跳到主要内容</a>
    <div id="main" class="page-wrapper">
      <nav class="pixel-nav" role="navigation" aria-label="主导航">
        <a href="/" class="logo pixel-logo">
          <span class="logo-coin">[▶]</span>
          <span class="logo-text">每日一影院</span>
        </a>
        <div class="nav-links">
          <a href="/" class:list={['nav-link', { 'active': activeTab === 'home' }]} title="首页">
            <span class="nav-icon">🏠</span>
            <span class="nav-label">首页</span>
          </a>
          <a href="/library/" class:list={['nav-link', { 'active': activeTab === 'library' }]} title="电影库">
            <span class="nav-icon">📼</span>
            <span class="nav-label">电影库</span>
          </a>
          <a href="/search/" class:list={['nav-link', { 'active': activeTab === 'search' }]} title="搜索">
            <span class="nav-icon">🔍</span>
            <span class="nav-label">搜索</span>
          </a>
          <a href="/archive/" class:list={['nav-link', { 'active': activeTab === 'archive' }]} title="归档">
            <span class="nav-icon">📅</span>
            <span class="nav-label">归档</span>
          </a>
          <button id="theme-toggle" class="icon-btn" aria-label="切换主题" title="切换日间/暗色模式">
            <span id="theme-icon">🌙</span>
          </button>
        </div>
      </nav>
      <main class="page-content">
        <slot />
      </main>
      <MobileTabBar />
      <Toast />
      <footer class="pixel-footer">
        <div class="footer-inner">
          <span class="footer-copy">© 2026 每日一影院</span>
          <div class="footer-links">
            <a href="/rss.xml">RSS</a>
            <a href="https://github.com/redisread/daily-movie" target="_blank" rel="noopener">GitHub</a>
          </div>
          <span class="footer-blink blink">█ INSERT COIN █</span>
        </div>
      </footer>
    </div>
  </body>
  <script>
    // Theme switching
    const THEME_KEY = 'daily-movie-theme';
    const stored = localStorage.getItem(THEME_KEY);
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = stored || (systemDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', current);

    const toggle = document.getElementById('theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.getAttribute('data-theme') === 'dark';
        const next = isDark ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem(THEME_KEY, next);
        const icon = document.getElementById('theme-icon');
        if (icon) icon.textContent = next === 'dark' ? '🌙' : '☀️';
      });
    }

    // Set initial icon
    const ic = document.getElementById('theme-icon');
    if (ic) {
      ic.textContent = current === 'dark' ? '🌙' : '☀️';
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 'Escape') {
        document.querySelectorAll('dialog[open]').forEach(d => (d as HTMLDialogElement).close());
      }
    });

    // Service Worker registration for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</html>

<style is:global>

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Links — inherited from CSS variables in theme */

  a {
    color: var(--link);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  a:hover {
    color: var(--accent-hover);
  }

  /* Focus visible for accessibility */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Skip to content link */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 8px;
    background: var(--accent);
    color: var(--bg-primary) !important;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: 600;
    z-index: 9999;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 8px;
  }

  /* Fade-in animation for page load */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Stagger animation for cards */
  @keyframes staggerIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Skeleton loading animation */
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .skeleton {
    background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-secondary) 50%, var(--bg-card) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite steps(8);
  }

  /* Page wrapper */
  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    flex: 1;
    padding-bottom: 0;
  }

  @media (max-width: 640px) {
    .page-content {
      padding-bottom: 60px;
    }
  }

  /* ===== Pixel Nav ===== */
  .pixel-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 16px;
    border-bottom: 3px solid var(--neon-cyan);
    background: var(--bg-overlay);
    position: sticky;
    top: 0;
    z-index: 999;
    image-rendering: pixelated;
  }

  .pixel-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .logo-coin {
    font-family: var(--font-display);
    font-size: 0.7rem;
    color: var(--neon-yellow);
    text-shadow: var(--glow-yellow);
    animation: spin-coin 2s steps(4) infinite;
  }
  @keyframes spin-coin {
    0%, 100% { transform: scaleX(1); }
    50% { transform: scaleX(0.2); }
  }
  .pixel-logo .logo-text {
    font-family: var(--font-display);
    font-size: 0.55rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pixel-logo:hover .logo-text { color: var(--neon-cyan); }

  .nav-links {
    display: flex;
    gap: 2px;
    align-items: center;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    color: var(--text-secondary);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.5rem;
    text-transform: uppercase;
    border: 2px solid transparent;
    transition: none;
  }
  .nav-link:hover {
    color: var(--neon-cyan);
    background: var(--accent-soft);
    border-color: var(--neon-cyan);
  }
  .nav-link.active {
    color: var(--neon-yellow);
    background: transparent;
    border-color: var(--neon-yellow);
  }
  .nav-icon {
    font-size: 0.9rem;
    line-height: 1;
    filter: saturate(1.5);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 2px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    font-size: 1rem;
    transition: none;
  }
  .icon-btn:hover {
    border-color: var(--neon-cyan);
    box-shadow: var(--glow-cyan);
  }

  /* ===== Nav responsive ===== */
  @media (max-width: 640px) {
    .nav-link .nav-label { display: none; }
    .nav-link { padding: 6px 8px; }
    .pixel-logo .logo-text { font-size: 0.45rem; }
  }

  @media (max-width: 400px) {
    .pixel-nav { padding: 6px 8px; }
    .pixel-logo .logo-text { display: none; }
    .nav-links { gap: 0; }
  }

  /* ===== Pixel footer ===== */
  .pixel-footer {
    border-top: 3px solid var(--neon-cyan);
    padding: 16px 24px;
    margin-top: 60px;
    background: var(--bg-secondary);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 0.45rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .footer-copy { color: var(--text-secondary); }

  .footer-links {
    display: flex;
    gap: 12px;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: none;
  }

  .footer-links a:hover {
    color: var(--neon-cyan);
    text-decoration: underline;
  }

  .footer-blink {
    color: var(--neon-yellow);
    font-size: 0.5rem;
    text-shadow: var(--glow-yellow);
  }

  @media (max-width: 720px) {
    .footer-inner { flex-direction: column; text-align: center; gap: 8px; }
  }

  /* View Transitions */
  @view-transition {
    navigation: auto;
  }

  /* Safe area insets */
  body {
    padding-top: env(safe-area-inset-top, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* ========== Navbar responsive ========== */
  @media (max-width: 640px) {
    .nav-link .nav-label { display: none; }
    .nav-link { padding: 6px 8px; }
    .nav-divider { display: none; }
    .logo-text { font-size: 1rem; }
    .global-navbar { padding: 8px 16px; }
  }

  @media (max-width: 400px) {
    .global-navbar { padding: 8px 10px; }
    .logo-text { display: none; }
    .nav-links { gap: 2px; }
  }
</style>
