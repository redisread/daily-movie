---
interface Props {
  title: string;
  description?: string;
  image?: string;
  activeTab?: 'home' | 'library' | 'search' | 'archive';
}

const {
  title,
  description = '每日一电影推荐，发现经典好电影',
  image,
  activeTab,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="每日一电影 RSS" href="/rss.xml" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <title>{title} | 每日一电影</title>
  </head>
  <body>
    <div class="page-wrapper">
      <nav class="global-navbar">
        <a href="/" class="logo">🎬 每日电影</a>
        <div class="nav-links">
          <a href="/" class:list={[{ 'active': activeTab === 'home' }]}>首页</a>
          <a href="/library/" class:list={[{ 'active': activeTab === 'library' }]}>电影库</a>
          <a href="/search/" class:list={[{ 'active': activeTab === 'search' }]}>搜索</a>
          <a href="/archive/" class:list={[{ 'active': activeTab === 'archive' }]}>归档</a>
          <a href="/rss.xml" class="rss-link" title="订阅 RSS" aria-label="RSS 订阅">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </a>
        </div>
      </nav>
      <main class="page-content">
        <slot />
      </main>
      <footer class="global-footer">
        <div class="footer-inner">
          <span>每日电影 © 2026</span>
          <div class="footer-links">
            <a href="/rss.xml">RSS 订阅</a>
            <a href="/archive/">归档</a>
            <a href="https://github.com/redisread/daily-movie" target="_blank" rel="noopener">GitHub</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #0f0f0f;
    --bg-secondary: #1a1a1a;
    --bg-card: #242424;
    --text-primary: #ffffff;
    --text-secondary: #a0a0a0;
    --accent: #f5c518;
    --accent-hover: #ffd54f;
    --link: #3b82f6;
    --border: #333333;
    --shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    --shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.4);
    --radius: 12px;
    --radius-lg: 16px;
    --font-family: 'Inter', 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-family);
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--bg-primary);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent-hover);
  }

  /* Fade-in animation for page load */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Stagger animation for cards */
  @keyframes staggerIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Skeleton loading animation */
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .skeleton {
    background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-secondary) 50%, var(--bg-card) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--radius);
  }

  /* Page wrapper */
  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    flex: 1;
  }

  /* Global navbar */
  .global-navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    border-bottom: 1px solid var(--border);
  }

  .global-navbar .logo {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary) !important;
  }

  .global-navbar .logo:hover {
    color: var(--accent) !important;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a.active {
    color: var(--accent);
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
  }

  .nav-links a:hover {
    color: var(--accent) !important;
  }

  .rss-link {
    display: flex;
    align-items: center;
    color: var(--accent) !important;
  }

  .rss-link:hover {
    color: var(--accent-hover) !important;
  }

  /* Global footer */
  .global-footer {
    border-top: 1px solid var(--border);
    padding: 24px 20px;
    margin-top: 60px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--accent) !important;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
