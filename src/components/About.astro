<section class="about-view" aria-labelledby="about-title">
  <h1 id="about-title">ABOUT</h1>
  <p class="about-subtitle">每日一部电影</p>

  <div class="about-body">
    <p>daily-movie 是一个每天推荐一部经典电影的小项目。</p>
    <p>不评分，不社交，不解释。</p>
    <p>只是每天遇见一部。</p>
  </div>

  <p class="about-back">
    <a href="#/" class="back-link" data-spa-link>← BACK</a>
  </p>
</section>

<style>
  .about-view {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--pad-v) var(--pad-h);
    gap: 2rem;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .about-view h1 {
    font-size: var(--size-detail);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0;
  }

  .about-subtitle {
    font-family: var(--font-serif);
    font-size: var(--size-caption);
    font-style: italic;
    font-weight: 400;
    color: rgba(10, 10, 10, 0.55);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 480px;
    margin: 2rem 0;
  }

  .about-body p {
    font-family: var(--font-serif);
    font-size: var(--size-body);
    line-height: 1.8;
    color: var(--ink);
    margin: 0;
  }

  .about-back {
    margin-top: 3rem;
  }

  .back-link {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    color: rgba(10, 10, 10, 0.45);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--gold);
  }

  /* Fade-in sequence */
  .about-view h1,
  .about-subtitle,
  .about-body,
  .about-back {
    opacity: 0;
    animation: v2-fade-in 0.8s ease-out forwards;
  }

  .about-view h1 { animation-delay: 0.1s; }
  .about-subtitle { animation-delay: 0.3s; }
  .about-body { animation-delay: 0.5s; }
  .about-back { animation-delay: 0.7s; }

  @keyframes v2-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-view h1,
    .about-subtitle,
    .about-body,
    .about-back {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }
</style>
