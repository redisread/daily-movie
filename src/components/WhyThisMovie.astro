---
/**
 * WhyThisMovie Component (Collapsible)
 *
 * Renders the "curation" line below the quote:
 *   "**《Movie Title》** 之所以今天该看，是因为 ___。"
 *
 * Default: collapsed (only shows a small "为什么是这部？" button).
 * On click: expands with fade-in.
 */

interface Props {
  title: string;
  reason: string;
}

const { title, reason } = Astro.props;
---

{
  reason && (
    <div class="why-this-movie-wrapper">
      <button type="button" class="why-toggle" id="why-toggle" aria-expanded="false">
        <span class="why-toggle-icon">？</span>
        <span class="why-toggle-text">为什么是这部</span>
      </button>
      <p class="why-this-movie" id="why-content" hidden>
        <strong class="why-title">《{title}》</strong>
        <span class="why-text">{reason}</span>
      </p>
    </div>
  )
}

<style>
  .why-this-movie-wrapper {
    margin: 0;
    padding: 0 1rem;
    max-width: 520px;
    text-align: center;
  }

  .why-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--text-muted, #8a7a60);
    background: none;
    border: 1px solid rgba(232, 213, 176, 0.15);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .why-toggle:hover {
    color: var(--color-brand, #f5b942);
    border-color: rgba(245, 185, 66, 0.3);
    background: rgba(245, 185, 66, 0.05);
  }

  .why-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-size: 0.625rem;
    font-weight: 700;
    font-style: normal;
    line-height: 1;
  }

  .why-toggle-text {
    font-style: normal;
  }

  .why-this-movie {
    margin: 8px 0 0;
    font-size: 0.8125rem;
    font-style: italic;
    opacity: 0.75;
    line-height: 1.6;
    color: var(--text-secondary, #e8d5b0);
    transition: opacity 0.4s ease;
  }

  .why-this-movie[hidden] {
    display: none;
  }

  .why-title {
    font-weight: 700;
    font-style: normal;
    color: var(--color-brand, #f5b942);
    margin-right: 0.25em;
  }

  .why-text {
    color: inherit;
  }

  .why-this-movie.fading {
    opacity: 0;
  }
</style>

<script>
  const toggle = document.getElementById("why-toggle");
  const content = document.getElementById("why-content");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));

    if (expanded) {
      content!.style.opacity = "0";
      setTimeout(() => {
        content!.setAttribute("hidden", "");
      }, 400);
    } else {
      content!.removeAttribute("hidden");
      // Force reflow then fade in
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          content!.style.opacity = "0.75";
        });
      });
    }
  });
</script>
