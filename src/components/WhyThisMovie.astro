---
/**
 * WhyThisMovie Component (Collapsible)
 *
 *   "**《Movie Title》** 之所以今天该看，是因为 ___。"
 *
 * Default: collapsed — small "为什么是这部？" button
 * On click: expands with fade-in
 */

interface Props {
  title: string;
  reason: string;
}

const { title, reason } = Astro.props;
---

{
  reason && (
    <div class="why-this-movie-wrapper">
      <button type="button" class="why-toggle" aria-expanded="false" aria-controls="why-content">
        <span class="why-toggle-icon">？</span>
        <span class="why-toggle-text">为什么是这部</span>
      </button>
      <p class="why-this-movie" id="why-content" hidden>
        <strong class="why-title">《{title}》</strong>
        <span class="why-text">{reason}</span>
      </p>
    </div>
  )
}

<style>
  .why-this-movie-wrapper {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .why-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    font-family: var(--font-body);
  }

  .why-toggle:hover {
    color: var(--gold);
    border-color: var(--gold);
    background: var(--gold-soft);
  }

  .why-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .why-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 0.65rem;
    font-weight: 700;
    font-style: normal;
    line-height: 1;
    flex-shrink: 0;
  }

  .why-toggle-text {
    font-style: normal;
    font-size: 0.8rem;
  }

  .why-this-movie {
    margin: 10px 0 0;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--text-secondary);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    border-left: 2px solid var(--accent);
    transition: opacity 0.4s ease;
  }

  .why-this-movie[hidden] {
    display: none;
  }

  .why-title {
    font-weight: 700;
    font-style: normal;
    color: var(--accent);
    margin-right: 0.25em;
  }

  .why-text {
    color: var(--text-secondary);
  }
</style>

<script>
  const toggle = document.querySelector('.why-toggle');
  const content = document.getElementById('why-content');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));

    if (expanded) {
      content!.style.opacity = '0';
      setTimeout(() => {
        content!.setAttribute('hidden', '');
      }, 400);
    } else {
      content!.removeAttribute('hidden');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          content!.style.opacity = '1';
        });
      });
    }
  });
</script>
