---
import type { Movie } from '../schemas/movie';
import QuoteCard from './QuoteCard.astro';

interface Props {
  movie: Movie;
  showPermalink?: boolean;
}

const { movie, showPermalink = false } = Astro.props;
---

<section id="detail" class="detail-section" aria-labelledby="detail-title">
  <div class="detail-content">
    <div class="detail-divider" aria-hidden="true"></div>

    <h2 id="detail-title" class="sr-only">影片详情</h2>

    <p class="detail-synopsis">{movie.synopsis}</p>

    <section class="quotes-section" aria-labelledby="quotes-title">
      <div class="quotes-heading">
        <h3 id="quotes-title">电影语录</h3>
        <span>{movie.quotes.length} 条</span>
      </div>
      <div class="quote-grid">
        {movie.quotes.map((quote, index) => <QuoteCard quote={quote} index={index + 1} />)}
      </div>
    </section>

    <dl class="detail-meta">
      <div class="meta-item">
        <dt>类型</dt>
        <dd>{movie.genre.join(' · ')}</dd>
      </div>
      <div class="meta-item">
        <dt>时长</dt>
        <dd>{movie.duration} 分钟</dd>
      </div>
    </dl>

    {showPermalink && (
      <p class="detail-permalink">
        <a href={`/movie/${movie.publishedDate}/`}>进入当日放映厅 →</a>
      </p>
    )}
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .detail-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--pad-v) var(--pad-h);
    background: var(--paper);
  }

  .detail-content {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .detail-divider {
    width: 4rem;
    height: 1px;
    background: rgba(10, 10, 10, 0.15);
    margin: 0 auto;
  }

  .detail-synopsis {
    font-size: var(--size-body);
    line-height: 1.9;
    color: var(--ink);
    text-align: left;
  }

  .quotes-section { width: min(100%, 52rem); text-align: start; }
  .quotes-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .quotes-heading h3 { font-size: 1.5rem; }
  .quotes-heading span { color: rgba(10, 10, 10, 0.6); font-size: 0.8rem; }
  .quote-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }

  .detail-meta {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin: 0;
  }

  .meta-item {
    text-align: center;
  }

  .meta-item dt {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.6);
    margin-bottom: 0.5rem;
  }

  .meta-item dd {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }

  .detail-permalink {
    margin-top: 1rem;
    font-size: 0.95rem;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .detail-meta {
      flex-direction: column;
      gap: 1.5rem;
    }

    .quote-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
