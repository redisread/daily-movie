---
import type { Movie } from '../schemas/movie';

interface Props {
  movie: Movie;
  showPermalink?: boolean;
}

const { movie, showPermalink = false } = Astro.props;
---

<section class="detail-section" aria-labelledby="detail-title">
  <div class="detail-content">
    <div class="detail-divider" aria-hidden="true"></div>

    <h2 id="detail-title" class="sr-only">影片详情</h2>

    <p class="detail-synopsis">{movie.synopsis}</p>

    {movie.quotes.length > 1 && (
      <blockquote class="detail-quote">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <span>{movie.quotes[1].text}</span>
        <span class="quote-mark" aria-hidden="true">&rdquo;</span>
        {movie.quotes[1].speaker && <cite>— {movie.quotes[1].speaker}</cite>}
      </blockquote>
    )}

    <dl class="detail-meta">
      <div class="meta-item">
        <dt>类型</dt>
        <dd>{movie.genre.join(' · ')}</dd>
      </div>
      <div class="meta-item">
        <dt>时长</dt>
        <dd>{movie.duration} 分钟</dd>
      </div>
    </dl>

    {showPermalink && (
      <p class="detail-permalink">
        <a href={`/movie/${movie.publishedDate}/`}>进入当日放映厅 →</a>
      </p>
    )}
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .detail-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--pad-v) var(--pad-h);
    background: var(--paper);
  }

  .detail-content {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .detail-divider {
    width: 4rem;
    height: 1px;
    background: rgba(10, 10, 10, 0.15);
    margin: 0 auto;
  }

  .detail-synopsis {
    font-size: var(--size-body);
    line-height: 1.9;
    color: var(--ink);
    text-align: left;
  }

  .detail-quote {
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.8;
    color: var(--ink);
    padding: 0 1.5rem;
  }

  .detail-quote cite {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-style: normal;
    color: rgba(10, 10, 10, 0.6);
  }

  .detail-meta {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin: 0;
  }

  .meta-item {
    text-align: center;
  }

  .meta-item dt {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.6);
    margin-bottom: 0.5rem;
  }

  .meta-item dd {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }

  .detail-permalink {
    margin-top: 1rem;
    font-size: 0.95rem;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .detail-meta {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>
