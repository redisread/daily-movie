---
import MovieCard from './MovieCard.astro';
import type { Movie } from '../schemas/movie';

interface Props {
  movies: Movie[];
}

const { movies } = Astro.props;
---

<section class="archive-view">
  <nav class="top-nav">
    <a href="#/" class="back" data-spa-link>← 返回首页</a>
    <h1>电影归档</h1>
    <span class="count">{movies.length} 部</span>
  </nav>

  <div class="movie-grid">
    {movies.map((movie, i) => (
      <MovieCard movie={movie} delay={i * 0.05} />
    ))}
  </div>
</section>

<style>
  .archive-view {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 24px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .back {
    color: var(--accent) !important;
    font-size: 0.95rem;
    font-weight: 500;
    flex-shrink: 0;
  }

  .top-nav h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    flex: 1;
    text-align: center;
  }

  .count {
    color: var(--text-secondary);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .movie-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
  }

  @media (max-width: 640px) {
    .movie-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .top-nav h1 {
      text-align: left;
      flex: none;
    }
  }
</style>
