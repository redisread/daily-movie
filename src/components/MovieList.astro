---
import MovieCard from './MovieCard.astro';
import type { Movie } from '../schemas/movie';

interface Props { movies: Movie[]; }
const { movies } = Astro.props;
---

<section class="library-view" data-view="archive" hidden aria-labelledby="library-title">
  <div class="library-heading">
    <div>
      <p class="eyebrow">THE LIBRARY</p>
      <h1 id="library-title">全部放映</h1>
      <p class="library-description">每一部电影都是一篇独立的 Markdown 文档。选一部，进入它的放映厅。</p>
    </div>
    <p class="library-count"><strong data-archive-count>{movies.length}</strong><span>部收藏</span></p>
  </div>

  <div class="library-tools">
    <label class="search-field">
      <span>搜索电影</span>
      <input type="search" placeholder="片名、导演或类型" data-movie-search />
    </label>
    <span class="tool-hint">按日期倒序 · 支持电影与剧集</span>
  </div>

  <div class="movie-grid" data-movie-grid>
    {movies.slice().reverse().map((movie, index) => <MovieCard movie={movie} delay={Math.min(index * 0.03, 0.3)} />)}
  </div>
  <p class="no-results" data-no-results hidden>没有找到匹配的电影。换个关键词试试。</p>
</section>

<style>
  .library-view { max-width: 76rem; margin: 0 auto; padding: clamp(3rem, 8vw, 7rem) var(--page-gutter) 7rem; }
  .library-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: 3rem; border-bottom: 1px solid var(--border); }
  .eyebrow { margin: 0; color: var(--accent); font-size: var(--size-label); letter-spacing: 0.15em; }
  .library-heading h1 { margin-top: 0.6rem; font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: 1; }
  .library-description { max-width: 29rem; margin: 1.2rem 0 0; color: var(--text-muted); font-size: 1rem; }
  .library-count { display: flex; flex-direction: column; align-items: end; gap: 0.25rem; margin: 0; color: var(--text-muted); font-size: 0.8rem; }
  .library-count strong { color: var(--ink); font-size: 3rem; font-weight: 400; line-height: 1; }
  .library-tools { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin: 2rem 0; }
  .search-field { display: grid; gap: 0.45rem; width: min(100%, 22rem); color: var(--text-muted); font-size: 0.74rem; letter-spacing: 0.08em; }
  .search-field input { width: 100%; min-height: 2.75rem; padding: 0.65rem 0.8rem; border: 1px solid var(--border); border-radius: 0; background: transparent; color: var(--ink); font: inherit; font-size: 0.95rem; letter-spacing: 0; }
  .search-field input:focus { border-color: var(--ink); outline: none; }
  .tool-hint { color: var(--text-muted); font-size: 0.78rem; }
  .movie-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .no-results { padding: 3rem 0; color: var(--text-muted); text-align: center; }

  @media (max-width: 980px) { .movie-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .library-heading { align-items: start; flex-direction: column; }
    .library-count { align-items: start; flex-direction: row; gap: 0.6rem; }
    .library-count strong { font-size: 1.2rem; }
    .library-tools { align-items: stretch; flex-direction: column; gap: 0.8rem; }
    .search-field { width: 100%; }
    .movie-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  }
  @media (max-width: 390px) { .movie-grid { grid-template-columns: 1fr; } }
</style>
