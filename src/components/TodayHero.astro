---
import type { Movie } from '../schemas/movie';

interface Props {
  movie: Movie;
  dateStr: string;
  prevMovie?: Movie | null;
  nextMovie?: Movie | null;
}

const { movie, dateStr, prevMovie, nextMovie } = Astro.props;
const topQuotes = movie?.quotes?.slice(0, 3) ?? [];

// Format date for display: e.g. "TUESDAY, JULY 12"
const dateObj = new Date(dateStr + 'T00:00:00');
const weekday = dateObj.toLocaleDateString('en-US', { weekday: 'long' });
const month = dateObj.toLocaleDateString('en-US', { month: 'long' });
const day = dateObj.getDate();
const displayDate = `${weekday.toUpperCase()}, ${month.toUpperCase()} ${day}`;
---

<section class="cinema" aria-labelledby="movie-title">
  <!-- 「今日影片」标签 -->
  <p class="badge-label" style="animation-delay: 0.2s;">「 今 日 影 片 」</p>

  <!-- 日期 -->
  <p class="date-label" style="animation-delay: 0.3s;">
    <time datetime={dateStr}>{displayDate}</time>
  </p>

  {movie && (
    <>
      <h1 id="movie-title" class="movie-title" style="animation-delay: 0.5s;">
        《{movie.title}》
      </h1>
      {movie.titleOriginal && (
        <p class="movie-title-original" style="animation-delay: 0.7s;">{movie.titleOriginal}</p>
      )}
      <p class="movie-meta" style="animation-delay: 0.9s;">
        {movie.director.name} · {movie.year}
        {movie.duration && ` · ${movie.duration}min`}
      </p>

      <!-- 封面图 -->
      {movie.cover?.url && (
        <div class="cover-wrap" style="animation-delay: 1.2s;">
          <img
            src={movie.cover.url}
            alt={movie.title}
            class="cover-img"
            loading="eager"
            width="480"
            height="680"
            onerror="this.style.display='none'"
          />
        </div>
      )}

      {topQuotes.map((quote, index) => (
        <blockquote class="stage-quote" style={`animation-delay: ${1.8 + index * 0.3}s`}>
          <span class="quote-mark quote-open" aria-hidden="true">&ldquo;</span>
          <span class="quote-text">{quote.text}</span>
          <span class="quote-mark quote-close" aria-hidden="true">&rdquo;</span>
          {quote.speaker && (
            <cite class="quote-speaker">—— {quote.speaker}</cite>
          )}
        </blockquote>
      ))}

      <!-- 上下篇导航 -->
      <nav class="prev-next-nav" style="animation-delay: 2.4s;" aria-label="上下篇导航">
        {prevMovie ? (
          <a href={`#/movie/${prevMovie.publishedDate}`} class="prev-link" data-spa-link>
            ← 第 {prevMovie.publishedDate} 部
          </a>
        ) : <span class="prev-link disabled">← 无</span>}
        <span class="current-pos">{movie.publishedDate}</span>
        {nextMovie ? (
          <a href={`#/movie/${nextMovie.publishedDate}`} class="next-link" data-spa-link>
            第 {nextMovie.publishedDate} 部 →
          </a>
        ) : <span class="next-link disabled">无 →</span>}
      </nav>

      <p class="enter" style="animation-delay: 2.8s;">
        <a href={`#/movie/${movie.publishedDate}`} class="enter-link" data-spa-link>
          ▽ DETAIL
        </a>
      </p>

      <p class="archive-link" style="animation-delay: 3.0s;">
        <a href="#/archive" class="archive-anchor" data-spa-link>
          浏览历史推荐
        </a>
      </p>
    </>
  )}
</section>

<style>
  .cinema {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--pad-v) var(--pad-h);
    gap: 1.5rem;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  /* Fade sequence — all elements animate in */
  .badge-label,
  .date-label,
  .movie-title,
  .movie-title-original,
  .movie-meta,
  .cover-wrap,
  .stage-quote,
  .prev-next-nav,
  .enter,
  .archive-link {
    opacity: 0;
    animation: v2-fade-in 1.2s ease-out forwards;
  }

  @keyframes v2-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Badge — 「今日影片」 */
  .badge-label {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    font-style: italic;
    font-weight: 400;
    color: rgba(10, 10, 10, 0.45);
    letter-spacing: 0.15em;
    margin-bottom: 0.25rem;
  }

  .date-label {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.55);
    margin-bottom: 1rem;
  }

  .movie-title {
    font-family: var(--font-serif);
    font-size: var(--size-hero);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0;
  }

  .movie-title-original {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    font-weight: 400;
    color: rgba(10, 10, 10, 0.6);
    letter-spacing: 0.01em;
    margin: 0;
  }

  .movie-meta {
    font-family: var(--font-serif);
    font-size: var(--size-caption);
    font-weight: 400;
    color: rgba(10, 10, 10, 0.55);
    letter-spacing: 0.02em;
    margin-top: 0.25rem;
  }

  /* Cover image */
  .cover-wrap {
    margin: 1.5rem 0;
    max-width: 320px;
    width: 100%;
    aspect-ratio: 2/3;
    overflow: hidden;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Quotes */
  .stage-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--ink);
    max-width: 34rem;
    margin: 3rem auto 0;
    position: relative;
    padding: 0 1.5rem;
  }

  .stage-quote + .stage-quote {
    margin-top: 1.5rem;
  }

  .quote-mark {
    color: var(--gold);
    font-size: 2rem;
    line-height: 1;
    font-family: var(--font-serif);
    vertical-align: -0.35em;
    margin: 0 0.15em;
  }

  .quote-text {
    display: inline;
  }

  .quote-speaker {
    display: block;
    margin-top: 1rem;
    font-size: 0.875rem;
    font-style: normal;
    color: rgba(10, 10, 10, 0.55);
    letter-spacing: 0.02em;
  }

  /* Prev / Next navigation */
  .prev-next-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: 0.875rem;
  }

  .prev-link,
  .next-link {
    color: rgba(10, 10, 10, 0.45);
    text-decoration: none;
    transition: color 0.3s ease;
    border-bottom: 1px solid transparent;
  }

  .prev-link:hover,
  .next-link:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  .prev-link.disabled,
  .next-link.disabled {
    color: rgba(10, 10, 10, 0.2);
    pointer-events: none;
  }

  .current-pos {
    color: rgba(10, 10, 10, 0.35);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  /* Enter link */
  .enter {
    margin-top: 2rem;
  }

  .enter-link {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    color: var(--ink);
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.3s ease;
  }

  .enter-link:hover {
    border-bottom-color: var(--ink);
  }

  /* Archive link */
  .archive-link {
    margin-top: 1.5rem;
  }

  .archive-anchor {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    color: rgba(10, 10, 10, 0.45);
    transition: color 0.3s ease;
  }

  .archive-anchor:hover {
    color: var(--gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-label,
    .date-label,
    .movie-title,
    .movie-title-original,
    .movie-meta,
    .cover-wrap,
    .stage-quote,
    .prev-next-nav,
    .enter,
    .archive-link {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }
</style>
