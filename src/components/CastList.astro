---
interface Props {
  cast: { name: string; role: string; avatar?: string }[];
}
const { cast } = Astro.props;
---
<div class="cast-list">
  {cast.map(member => (
    <div class="cast-item">
      {member.avatar && <img src={member.avatar} alt={member.name} class="avatar" onerror="this.style.display='none'" />}
      <div class="cast-info">
        <p class="name">{member.name}</p>
        <p class="role">饰 {member.role}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .cast-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .cast-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: var(--bg-secondary);
    border-radius: var(--radius);
    transition: transform 0.2s ease;
  }

  .cast-item:hover {
    transform: translateY(-2px);
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
  }

  .name {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
    font-size: 0.95rem;
  }

  .role {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .cast-list {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    }
  }
</style>
