<script>
  const selector = document.currentScript?.closest('[data-component]')?.getAttribute('data-selector') || '[data-animate]';
  const threshold = parseFloat(document.currentScript?.closest('[data-component]')?.getAttribute('data-threshold') || '0.1');
  const rootMargin = document.currentScript?.closest('[data-component]')?.getAttribute('data-rootmargin') || '0px 0px -50px 0px';
  const animateClass = document.currentScript?.closest('[data-component]')?.getAttribute('data-animate-class') || 'in-view';

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add(animateClass);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold, rootMargin }
    );

    // Observe elements after page load
    const observe = () => {
      document.querySelectorAll(selector).forEach(el => {
        observer.observe(el);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observe);
    } else {
      observe();
    }
  }
</script>
