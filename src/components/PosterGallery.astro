---
interface Props {
  posters: { url: string; caption?: string }[];
}
const { posters } = Astro.props;
---
<div class="poster-gallery">
  {posters.map((poster, idx) => (
    <figure>
      <img src={poster.url} alt={poster.caption || `海报 ${idx+1}`} loading="lazy" />
      {poster.caption && <figcaption>{poster.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .poster-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
  }

  figure {
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #f8f9fa;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  img:hover {
    transform: scale(1.02);
  }

  figcaption {
    padding: 8px 12px;
    font-size: 0.85rem;
    color: #666;
    text-align: center;
  }
</style>

<script>
  // 海报点击放大（灯箱效果）
  document.querySelectorAll('.poster-gallery img').forEach(img => {
    img.addEventListener('click', () => {
      const overlay = document.createElement('div');
      overlay.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        cursor: pointer;
      `;
      const bigImg = document.createElement('img');
      bigImg.src = (img as HTMLImageElement).src;
      bigImg.style.cssText = 'max-width: 90%; max-height: 90%; object-fit: contain;';
      overlay.appendChild(bigImg);
      overlay.addEventListener('click', () => overlay.remove());
      document.body.appendChild(overlay);
    });
  });
</script>
