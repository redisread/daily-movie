---
import type { Movie } from '../schemas/movie';

interface Props {
  movie: Movie;
}

const { movie } = Astro.props;
---

<a href={`/movie/${movie.publishedDate}/`} class="featured-card">
  <div class="featured-cover" style={`background: ${movie.cover.bg}`}>
    <img src={movie.cover.url} alt={movie.title} loading="lazy" class="poster-img" onerror="this.src='/fallback-poster.svg'; this.classList.add('loaded')" />
  </div>
  <div class="featured-info">
    <span class="featured-badge">今日推荐</span>
    <h2>{movie.title}</h2>
    {movie.titleOriginal && <p class="original">{movie.titleOriginal}</p>}
    <div class="meta">
      <span class="rating">⭐ {movie.rating}</span>
      <span class="genre">{movie.genre.join(' / ')}</span>
      <span class="duration">{movie.duration}分钟</span>
    </div>
    <p class="director">导演：{movie.director.name}</p>
    <span class="cta">查看详情 →</span>
  </div>
</a>

<script>
  // Image fade-in on load
  document.querySelectorAll('.featured-card .poster-img').forEach(img => {
    const image = img as HTMLImageElement;
    if (image.complete) {
      image.classList.add('loaded');
    } else {
      image.addEventListener('load', () => image.classList.add('loaded'));
      image.addEventListener('error', () => image.classList.add('loaded'));
    }
  });
</script>

<style>
  .featured-card {
    display: flex;
    gap: 32px;
    padding: 32px;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    animation: fadeIn 0.5s ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .featured-cover {
    flex-shrink: 0;
    width: 280px;
    height: 400px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .featured-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, opacity 0.6s ease;
    opacity: 0;
  }

  .featured-cover img.loaded,
  .featured-cover img[src='/fallback-poster.svg'] {
    opacity: 1;
  }

  .featured-card:hover .featured-cover img {
    transform: scale(1.02);
  }

  .featured-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .featured-badge {
    display: inline-block;
    width: fit-content;
    padding: 4px 12px;
    background: var(--accent);
    color: var(--bg-primary);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 4px;
  }

  .featured-info h2 {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .original {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.95rem;
  }

  .rating {
    color: var(--accent);
    font-weight: 600;
    font-size: 1.2rem;
  }

  .genre, .duration {
    color: var(--text-secondary);
  }

  .director {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .cta {
    display: inline-block;
    margin-top: 8px;
    padding: 12px 24px;
    background: var(--accent);
    color: var(--bg-primary);
    font-weight: 600;
    border-radius: var(--radius);
    width: fit-content;
    transition: background 0.2s ease;
  }

  .cta:hover {
    background: var(--accent-hover);
  }

  @media (max-width: 768px) {
    .featured-card {
      flex-direction: column;
      padding: 20px;
      gap: 20px;
    }

    .featured-cover {
      width: 100%;
      height: 320px;
    }
  }
</style>
