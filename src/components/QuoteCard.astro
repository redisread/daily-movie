---
interface Props {
  quote: { text: string; speaker?: string; timestamp?: string };
  index?: number;
}
const { quote, index } = Astro.props;
---
<blockquote class="quote-card">
  <div class="quote-topline">
    {index && <span class="quote-index">{String(index).padStart(2, '0')}</span>}
    {quote.timestamp && <time>{quote.timestamp}</time>}
  </div>
  <p class="text">“{quote.text}”</p>
  <footer>
    {quote.speaker && <cite>— {quote.speaker}</cite>}
  </footer>
</blockquote>

<style>
  .quote-card {
    display: flex;
    flex-direction: column;
    min-height: 12rem;
    margin: 0;
    padding: 1.35rem;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.14);
  }

  .quote-topline { display: flex; justify-content: space-between; gap: 1rem; color: var(--gold); font-size: 0.75rem; }
  .quote-index { font-variant-numeric: tabular-nums; }

  .text {
    margin: auto 0;
    font-size: 1.06rem;
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  footer {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  cite {
    font-style: italic;
  }

  time { font-family: var(--font-mono); font-size: 0.7rem; }
</style>
