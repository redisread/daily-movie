---
interface Props {
  quote: { text: string; speaker?: string; timestamp?: string };
}
const { quote } = Astro.props;
---
<blockquote class="quote-card">
  <p class="text">「{quote.text}」</p>
  <footer>
    {quote.speaker && <cite>— {quote.speaker}</cite>}
    {quote.timestamp && <time>{quote.timestamp}</time>}
  </footer>
</blockquote>

<style>
  .quote-card {
    padding: 20px;
    background: #f8f9fa;
    border-left: 4px solid #667eea;
    border-radius: 0 8px 8px 0;
    margin-bottom: 16px;
  }

  .text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
    margin-bottom: 8px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #666;
  }

  cite {
    font-style: italic;
  }

  time {
    background: #e9ecef;
    padding: 2px 8px;
    border-radius: 4px;
  }
</style>
