---
interface Props {
  quote: { text: string; speaker?: string; timestamp?: string };
}
const { quote } = Astro.props;
---
<blockquote class="quote-card">
  <p class="text">「{quote.text}」</p>
  <footer>
    {quote.speaker && <cite>— {quote.speaker}</cite>}
    {quote.timestamp && <time>{quote.timestamp}</time>}
  </footer>
</blockquote>

<style>
  .quote-card {
    padding: 20px;
    background: var(--bg-secondary);
    border-left: 3px solid var(--gold-deep);
    border-radius: 0 var(--radius) var(--radius) 0;
    margin-bottom: 12px;
  }

  .text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  cite {
    font-style: italic;
  }

  time {
    background: var(--bg-card);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.8rem;
  }
</style>
