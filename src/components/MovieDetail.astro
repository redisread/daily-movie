---
import type { Movie } from '../schemas/movie';

interface Props {
  movie: Movie;
}

const { movie } = Astro.props;
---

<article class="movie-detail" aria-labelledby="detail-title">
  <nav class="back-nav">
    <a href="#/" class="back-link" data-spa-link>← 返回</a>
  </nav>

  <header class="detail-header">
    <h1 id="detail-title" class="detail-title">{movie.title}</h1>
    {movie.titleOriginal && (
      <p class="detail-original">{movie.titleOriginal}</p>
    )}
    <p class="detail-meta">
      {movie.director.name} · {movie.year}
      {movie.duration && ` · ${movie.duration}min`}
    </p>
  </header>

  <hr class="detail-divider" />

  <section class="detail-synopsis" aria-labelledby="synopsis-heading">
    <h2 id="synopsis-heading" class="sr-only">剧情简介</h2>
    <p>{movie.synopsis}</p>
  </section>

  {movie.quotes.length > 0 && (
    <section class="detail-quotes" aria-labelledby="quotes-heading">
      <h2 id="quotes-heading" class="sr-only">经典语录</h2>
      {movie.quotes.map((quote) => (
        <blockquote class="detail-quote">
          <span class="quote-mark" aria-hidden="true">&ldquo;</span>
          <span class="quote-text">{quote.text}</span>
          <span class="quote-mark" aria-hidden="true">&rdquo;</span>
          {quote.speaker && (
            <cite class="quote-speaker">—— {quote.speaker}</cite>
          )}
        </blockquote>
      ))}
    </section>
  )}
</article>

<style>
  .movie-detail {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--pad-v) var(--pad-h);
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    gap: 2.5rem;
  }

  /* Fade-in sequence for detail view */
  .detail-title,
  .detail-original,
  .detail-meta,
  .detail-divider,
  .detail-synopsis,
  .detail-quotes {
    opacity: 0;
    animation: v2-fade-in 0.8s ease-out forwards;
  }

  .detail-title   { animation-delay: 0.1s; }
  .detail-original { animation-delay: 0.25s; }
  .detail-meta    { animation-delay: 0.4s; }
  .detail-divider { animation-delay: 0.55s; }
  .detail-synopsis { animation-delay: 0.7s; }
  .detail-quotes  { animation-delay: 0.9s; }

  @keyframes v2-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Back nav */
  .back-nav {
    align-self: flex-start;
    margin-bottom: 1rem;
  }

  .back-link {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    color: rgba(10, 10, 10, 0.45);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--gold);
  }

  /* Header */
  .detail-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .detail-title {
    font-family: var(--font-serif);
    font-size: var(--size-detail);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0;
  }

  .detail-original {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 400;
    color: rgba(10, 10, 10, 0.55);
    margin: 0;
  }

  .detail-meta {
    font-family: var(--font-serif);
    font-size: var(--size-caption);
    font-style: italic;
    font-weight: 400;
    color: rgba(10, 10, 10, 0.5);
    letter-spacing: 0.02em;
    margin: 0.25rem 0 0;
  }

  /* Divider */
  .detail-divider {
    width: 60px;
    border: none;
    border-top: 1px solid rgba(10, 10, 10, 0.15);
    margin: 0;
  }

  /* Synopsis */
  .detail-synopsis {
    font-family: var(--font-serif);
    font-size: var(--size-body);
    line-height: 1.8;
    color: var(--ink);
    max-width: 540px;
    text-align: left;
  }

  .detail-synopsis p {
    margin: 0;
  }

  /* Quotes */
  .detail-quotes {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 540px;
    width: 100%;
  }

  .detail-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--ink);
    margin: 0;
    padding: 0;
    position: relative;
  }

  .quote-mark {
    color: var(--gold);
    font-size: 1.75rem;
    line-height: 1;
    font-family: var(--font-serif);
    vertical-align: -0.3em;
    margin: 0 0.1em;
  }

  .quote-speaker {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-style: normal;
    color: rgba(10, 10, 10, 0.5);
    letter-spacing: 0.02em;
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .detail-title,
    .detail-original,
    .detail-meta,
    .detail-divider,
    .detail-synopsis,
    .detail-quotes {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }
</style>
