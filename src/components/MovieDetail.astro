---
import QuoteCard from './QuoteCard.astro';
import type { Movie } from '../schemas/movie';

interface Props { movie: Movie; prevMovie?: Movie; nextMovie?: Movie; }
const { movie, prevMovie, nextMovie } = Astro.props;
---

<article class="detail-view" data-view="detail" data-movie-detail data-movie-date={movie.publishedDate} hidden aria-labelledby={`detail-title-${movie.id}`}>
  <div class="detail-topbar">
    <a href="#/" class="back-link">← 返回今日放映</a>
    <span>{movie.publishedDate.replaceAll('-', '.')} · {movie.type === 'tv' ? '剧集' : '电影'}</span>
  </div>

  <header class="detail-header">
    <p class="eyebrow">IN THE SCREENING ROOM</p>
    <h1 id={`detail-title-${movie.id}`} class="detail-title">{movie.title}</h1>
    {movie.titleOriginal && <p class="detail-original">{movie.titleOriginal}</p>}
    <p class="detail-meta">{movie.director.name} · {movie.year} · {movie.genre.join(' / ')}</p>
  </header>

  <div class="detail-layout">
    <aside class="detail-aside">
      <div class="detail-poster" style={`background: ${movie.cover.bg}`}>
        <img src={movie.cover.url} alt={`《${movie.title}》电影海报`} loading="lazy" width="500" height="750" onerror="this.src='/fallback-poster.svg'; this.classList.add('loaded')" />
      </div>
      <dl class="fact-list">
        <div><dt>评分</dt><dd>{movie.rating.toFixed(1)} / 10</dd></div>
        <div><dt>时长</dt><dd>{movie.duration} 分钟</dd></div>
        <div><dt>语录</dt><dd>{movie.quotes.length} 条</dd></div>
        <div><dt>导演</dt><dd>{movie.director.name}</dd></div>
      </dl>
    </aside>

    <div class="detail-body">
      <section class="synopsis-block" aria-labelledby={`synopsis-${movie.id}`}>
        <p class="section-label">THE STORY</p>
        <h2 id={`synopsis-${movie.id}`}>关于这部电影</h2>
        <p>{movie.synopsis}</p>
      </section>

      <section class="quotes-block" aria-labelledby={`quotes-${movie.id}`}>
        <div class="section-heading"><div><p class="section-label">LINES TO KEEP</p><h2 id={`quotes-${movie.id}`}>电影语录</h2></div><span>{movie.quotes.length} 条</span></div>
        <div class="quote-list">
          {movie.quotes.map((quote, index) => <QuoteCard quote={quote} index={index + 1} />)}
        </div>
      </section>

      {movie.whyThisMovie && <section class="why-block"><p class="section-label">CURATOR'S NOTE</p><p>{movie.whyThisMovie}</p></section>}
    </div>
  </div>

  <nav class="detail-pager" aria-label="相邻影片">
    {prevMovie ? <a href={`#/movie/${prevMovie.publishedDate}`}><span>← 上一部</span><strong>{prevMovie.title}</strong></a> : <span></span>}
    {nextMovie ? <a href={`#/movie/${nextMovie.publishedDate}`} class="next"><span>下一部 →</span><strong>{nextMovie.title}</strong></a> : <span></span>}
  </nav>
</article>

<style>
  .detail-view { max-width: 76rem; margin: 0 auto; padding: 1.2rem var(--page-gutter) 7rem; }
  .detail-topbar, .detail-pager { display: flex; justify-content: space-between; gap: 1rem; color: var(--text-muted); font-size: 0.78rem; }
  .detail-topbar { padding-bottom: 1.2rem; border-bottom: 1px solid var(--border); }
  .back-link { color: var(--ink); }
  .back-link:hover { color: var(--gold); }
  .detail-header { padding: clamp(4rem, 10vw, 8rem) 0 clamp(3rem, 7vw, 6rem); }
  .eyebrow, .section-label { margin: 0; color: var(--accent); font-size: var(--size-label); letter-spacing: 0.15em; }
  .detail-title { max-width: 48rem; margin-top: 0.7rem; font-size: clamp(3rem, 9vw, 8rem); line-height: 0.95; letter-spacing: -0.06em; }
  .detail-original { margin: 1rem 0 0; color: var(--text-muted); font-size: 1.25rem; font-style: italic; }
  .detail-meta { margin: 1.5rem 0 0; color: var(--text-muted); font-size: 0.9rem; }
  .detail-layout { display: grid; grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr); gap: clamp(3rem, 9vw, 9rem); align-items: start; }
  .detail-poster { aspect-ratio: 2 / 3; overflow: hidden; }
  .detail-poster img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s ease; }
  .detail-poster img.loaded, .detail-poster img[src='/fallback-poster.svg'] { opacity: 1; }
  .fact-list { display: grid; gap: 0.8rem; margin: 1.5rem 0 0; }
  .fact-list div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--border); font-size: 0.82rem; }
  .fact-list dt { color: var(--text-muted); }
  .fact-list dd { margin: 0; text-align: end; }
  .detail-body { display: grid; gap: clamp(4rem, 9vw, 8rem); }
  .synopsis-block { max-width: 38rem; }
  .detail-body h2 { margin-top: 0.7rem; font-size: clamp(2rem, 4vw, 3.5rem); }
  .synopsis-block > p:last-child { margin: 1.75rem 0 0; color: var(--text-muted); font-size: 1.05rem; line-height: 1.95; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .section-heading > span { color: var(--text-muted); font-size: 0.8rem; }
  .quote-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .why-block { max-width: 38rem; border-top: 1px solid var(--border); padding-top: 1.5rem; }
  .why-block p:last-child { margin: 1rem 0 0; color: var(--text-muted); font-style: italic; line-height: 1.8; }
  .detail-pager { margin-top: clamp(5rem, 12vw, 10rem); border-top: 1px solid var(--border); padding-top: 1.2rem; }
  .detail-pager a { display: grid; gap: 0.4rem; color: var(--ink); }
  .detail-pager a span { color: var(--text-muted); font-size: 0.76rem; }
  .detail-pager a strong { font-size: 1rem; font-weight: 400; }
  .detail-pager .next { text-align: end; }

  @media (max-width: 700px) {
    .detail-topbar { align-items: start; flex-direction: column-reverse; }
    .detail-layout { grid-template-columns: 1fr; gap: 3rem; }
    .detail-poster { width: min(65vw, 18rem); }
    .quote-list { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) { .detail-poster img { transition: none; } }
</style>
