---
import type { Movie } from '../schemas/movie';

interface Props {
  movie: Movie;
  delay?: number;
}

const { movie, delay = 0 } = Astro.props;
---

<a
  href={`#/movie/${movie.publishedDate}`}
  class="movie-card"
  data-movie-card
  data-search-text={`${movie.title} ${movie.titleOriginal ?? ''} ${movie.director.name} ${movie.genre.join(' ')}`}
  style={`animation-delay: ${delay}s`}
>
  <div class="cover" style={`background: ${movie.cover.bg}`}>
    <img src={movie.cover.url} alt={movie.title} loading="lazy" width="300" height="450" onerror="this.src='/fallback-poster.svg'; this.classList.add('loaded')" class="poster-img" />
  </div>
  <div class="info">
    <div class="card-heading">
      <span class="card-date">{movie.publishedDate.replaceAll('-', '.')}</span>
      <span class="card-type">{movie.type === 'tv' ? '剧集' : '电影'}</span>
    </div>
    <h3>{movie.title}</h3>
    <div class="meta">
      <span class="rating">{movie.rating.toFixed(1)} 分</span>
      <span class="year">{movie.year} · {movie.quotes.length} 条语录</span>
    </div>
  </div>
</a>

<style>
  .movie-card {
    display: block;
    border-radius: 2px;
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: transform 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
    color: inherit;
    animation: staggerIn 0.5s ease backwards;
  }

  .movie-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 2/3;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease, transform 0.3s ease;
  }

  .cover img.loaded,
  .cover img[src='/fallback-poster.svg'] {
    opacity: 1;
  }

  .movie-card:hover .cover img {
    transform: scale(1.05);
  }

  .info {
    padding: 1rem 1rem 1.1rem;
  }

  .card-heading,
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-heading {
    margin-bottom: 0.55rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-type {
    color: var(--accent);
  }

  .info h3 {
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.8rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  .rating {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
  }

  .year {
    font-size: 0.76rem;
    color: var(--text-secondary);
    text-align: end;
  }

  @media (max-width: 640px) {
    .info h3 {
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .movie-card,
    .movie-card:hover,
    .cover img,
    .movie-card:hover .cover img {
      animation: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Image fade-in on load
  document.querySelectorAll<HTMLImageElement>('.poster-img').forEach(img => {
    if (img.complete) {
      img.classList.add('loaded');
    } else {
      img.addEventListener('load', () => img.classList.add('loaded'));
      img.addEventListener('error', () => img.classList.add('loaded'));
    }
  });
</script>
