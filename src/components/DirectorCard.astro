---
interface Props {
  director: { name: string; works?: string };
}
const { director } = Astro.props;
---
<div class="director-card">
  <div class="director-info">
    <span class="label">导演</span>
    <p class="name">{director.name}</p>
    {director.works && <p class="works">代表作：{director.works}</p>}
  </div>
</div>

<style>
  .director-card {
    padding: 20px;
    background: var(--bg-secondary);
    border-radius: var(--radius);
    border-left: 3px solid var(--accent);
  }

  .director-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .works {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>
