---
import type { Movie } from '../schemas/movie';

interface Props {
  movie: Movie;
  dateStr: string;
  mode: 'home' | 'permalink';
  prevMovie?: Movie;
  nextMovie?: Movie;
  totalCount?: number;
  currentIndex?: number;
}

const { movie, dateStr, mode, prevMovie, nextMovie, totalCount, currentIndex } = Astro.props;

const displayDate = new Date(dateStr + 'T00:00:00').toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long',
});

const topQuote = movie.quotes[0];
const label = mode === 'home' ? "今日影片" : displayDate;
---

<section class="hero-cinema" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-label">{label}</p>

    <h1 id="hero-title" class="hero-title">{movie.title}</h1>

    {movie.titleOriginal && (
      <p class="hero-original">{movie.titleOriginal}</p>
    )}

    <p class="hero-meta">
      {movie.director.name} · {movie.year}
    </p>

    {topQuote && (
      <blockquote class="hero-quote">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <span class="quote-text">{topQuote.text}</span>
        <span class="quote-mark" aria-hidden="true">&rdquo;</span>
        {topQuote.speaker && <cite class="quote-speaker">— {topQuote.speaker}</cite>}
      </blockquote>
    )}

    {movie.cover?.url && (
      <div class="hero-cover">
        <img
          src={movie.cover.url}
          alt={`《${movie.title}》封面`}
          loading={mode === 'home' ? 'eager' : 'lazy'}
          onerror="this.src='/fallback-poster.svg';"
        />
      </div>
    )}

    <nav class="hero-nav" aria-label="上下篇导航">
      {prevMovie ? (
        <a href={`/movie/${prevMovie.publishedDate}/`} class="nav-link nav-prev" aria-label={`上一部：${prevMovie.title}`}>
          <span class="nav-arrow" aria-hidden="true">←</span>
          <span class="nav-label">上一部</span>
        </a>
      ) : (
        <button type="button" class="nav-link nav-prev is-disabled" disabled aria-label="没有上一部">
          <span class="nav-arrow" aria-hidden="true">←</span>
        </button>
      )}

      {totalCount !== undefined && currentIndex !== undefined && (
        <span class="nav-counter">
          第 {currentIndex + 1} 部 / 共 {totalCount} 部
        </span>
      )}

      {nextMovie ? (
        <a href={`/movie/${nextMovie.publishedDate}/`} class="nav-link nav-next" aria-label={`下一部：${nextMovie.title}`}>
          <span class="nav-label">下一部</span>
          <span class="nav-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <button type="button" class="nav-link nav-next is-disabled" disabled aria-label="没有下一部">
          <span class="nav-arrow" aria-hidden="true">→</span>
        </button>
      )}
    </nav>

    {mode === 'home' && (
      <p class="hero-detail-cta">
        <a href="#detail" class="detail-anchor">
          <span aria-hidden="true">▽</span> DETAIL
        </a>
      </p>
    )}
  </div>
</section>

<style>
  .hero-cinema {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--pad-v) var(--pad-h);
    text-align: center;
    background: var(--paper);
  }

  .hero-content {
    max-width: 52rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-content > * {
    opacity: 0;
    animation: v2-rise 1s ease-out forwards;
  }

  .hero-label {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.6);
    margin: 0;
  }

  .hero-title {
    font-size: var(--size-hero);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
  }

  .hero-original {
    font-size: 1.125rem;
    font-style: italic;
    color: rgba(10, 10, 10, 0.6);
    margin: -0.5rem 0 0;
  }

  .hero-meta {
    font-size: var(--size-caption);
    font-style: italic;
    color: rgba(10, 10, 10, 0.6);
    margin: 0;
  }

  .hero-quote {
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.8;
    color: var(--ink);
    max-width: 34rem;
    margin: 2rem 0 0;
    padding: 0 1.5rem;
    position: relative;
  }

  .quote-mark {
    color: var(--gold);
    font-size: 2rem;
    line-height: 1;
    vertical-align: -0.35em;
    margin: 0 0.1em;
  }

  .quote-speaker {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-style: normal;
    color: rgba(10, 10, 10, 0.6);
  }

  .hero-cover {
    margin-top: 2.5rem;
    width: min(280px, 60vw);
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }

  .hero-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: v2-fade-in 1.2s ease-out 0.8s forwards;
  }

  .hero-cover img[src='/fallback-poster.svg'],
  .hero-cover img.loaded {
    opacity: 1;
    animation: none;
  }

  .hero-nav {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    font-size: 0.875rem;
    color: rgba(10, 10, 10, 0.6);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0;
    border: none;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .nav-link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .nav-link.is-disabled,
  .nav-link.is-disabled:hover {
    opacity: 0.25;
    cursor: default;
    border-bottom-color: transparent;
  }

  .nav-link.is-disabled .nav-label {
    display: none;
  }

  .nav-counter {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  .hero-detail-cta {
    margin-top: 2rem;
    font-size: 0.875rem;
    font-style: italic;
    letter-spacing: 0.1em;
  }

  .detail-anchor {
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
  }

  .detail-anchor:hover {
    color: var(--gold);
  }

  /* Entry sequence delays (total ~3s) */
  .hero-label    { animation-delay: 0.2s; }
  .hero-title    { animation-delay: 0.5s; }
  .hero-original { animation-delay: 0.7s; }
  .hero-meta     { animation-delay: 0.9s; }
  .hero-quote    { animation-delay: 1.2s; }
  .hero-cover    { animation-delay: 0.8s; }
  .hero-nav      { animation-delay: 1.8s; }
  .hero-detail-cta { animation-delay: 2.2s; }

  @keyframes v2-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes v2-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content > *,
    .hero-cover img {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  // Mark loaded images so fallback doesn't flash
  document.querySelectorAll('.hero-cover img').forEach(img => {
    if (img.complete) img.classList.add('loaded');
    else img.addEventListener('load', () => img.classList.add('loaded'));
  });
</script>
