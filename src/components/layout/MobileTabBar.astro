---
const tabs = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/library/', label: '电影库', icon: 'grid' },
  { href: '/search/', label: '搜索', icon: 'search' },
  { href: '/archive/', label: '归档', icon: 'archive' },
];

const currentPath = Astro.url.pathname;
---

<nav class="mobile-tab-bar" role="navigation" aria-label="底部导航">
  {tabs.map(tab => (
    <a
      href={tab.href}
      class:list={['tab-item', { 'active': currentPath === tab.href || (tab.href !== '/' && currentPath.startsWith(tab.href)) }]}
      aria-label={tab.label}
      role="button"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {tab.icon === 'home' && <><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></>}
        {tab.icon === 'grid' && <><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></>}
        {tab.icon === 'search' && <><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></>}
        {tab.icon === 'archive' && <><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></>}
      </svg>
      <span>{tab.label}</span>
    </a>
  ))}
</nav>

<style>
  .mobile-tab-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: 8px 0;
    padding-bottom: calc(8px + env(safe-area-inset-bottom, 0px));
    z-index: 1000;
  }

  .tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
    padding: 6px 0;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.7rem;
    transition: color 0.2s ease;
  }

  .tab-item svg {
    width: 22px;
    height: 22px;
  }

  .tab-item.active {
    color: var(--gold-deep);
  }

  .tab-item:active {
    scale: 0.96;
  }

  @media (max-width: 640px) {
    .mobile-tab-bar {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-item,
    .tab-item:active {
      transform: none;
      transition: none;
    }
  }
</style>
