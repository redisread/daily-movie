---
const tabs = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/library/', label: '电影库', icon: 'grid' },
  { href: '/search/', label: '搜索', icon: 'search' },
  { href: '/archive/', label: '归档', icon: 'archive' },
];

const currentPath = Astro.url.pathname;
---

<nav class="mobile-tab-bar" role="navigation" aria-label="底部导航">
  {tabs.map(tab => (
    <a
      href={tab.href}
      class:list={['tab-item', { 'active': currentPath === tab.href || (tab.href !== '/' && currentPath.startsWith(tab.href)) }]}
      aria-label={tab.label}
      role="button"
    >
      <span class="tab-icon">
        {tab.icon === 'home' && '🏠'}
        {tab.icon === 'grid' && '📼'}
        {tab.icon === 'search' && '🔍'}
        {tab.icon === 'archive' && '📅'}
      </span>
      <span>{tab.label}</span>
    </a>
  ))}
</nav>

<style>
  .mobile-tab-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--bg-overlay);
    border-top: 3px solid var(--neon-cyan);
    padding: 6px 0;
    padding-bottom: calc(6px + env(safe-area-inset-bottom, 0px));
    z-index: 1000;
    image-rendering: pixelated;
  }

  .tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    flex: 1;
    padding: 4px 0;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.4rem;
    text-transform: uppercase;
    transition: none;
    border: 2px solid transparent;
  }

  .tab-item .tab-icon {
    font-size: 1.2rem;
    line-height: 1;
  }

  .tab-item.active {
    color: var(--neon-yellow);
    border-color: var(--neon-yellow);
  }

  .tab-item:active {
    transform: translate(1px, 1px);
  }

  @media (max-width: 640px) {
    .mobile-tab-bar {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-item,
    .tab-item:active {
      transform: none;
    }
  }
</style>
