---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="页面未找到">
  <main class="error-page">
    <div class="error-content">
      <h1>404</h1>
      <p class="error-title">页面未找到</p>
      <p class="error-desc">您访问的页面不存在或已被移除</p>
      <a href="/" class="cta">返回首页</a>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: 40px 20px;
  }

  .error-content h1 {
    font-size: 6rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 16px;
  }

  .error-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .error-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  .cta {
    display: inline-block;
    padding: 12px 28px;
    background: var(--accent);
    color: var(--bg-primary) !important;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .cta:hover {
    background: var(--accent-hover) !important;
  }
</style>
