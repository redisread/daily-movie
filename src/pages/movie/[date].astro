---
import Layout from '../../layouts/Layout.astro';
import DirectorCard from '../../components/DirectorCard.astro';
import CastList from '../../components/CastList.astro';
import PosterGallery from '../../components/PosterGallery.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import WhyThisMovie from '../../components/WhyThisMovie.astro';
import { movies } from '../../data/movies';

export async function getStaticPaths() {
  return movies.map(movie => ({
    params: { date: movie.publishedDate },
    props: { movie },
  }));
}

const { movie } = Astro.props;

// date for reference if needed in template via Today's date in page header
const today = new Date();
void today;

// 相似电影推荐：同类型筛选，按评分排序，排除当前，最多4部
const similarMovies = movies
  .filter(m => m.id !== movie.id && m.genre.some(g => movie.genre.includes(g)))
  .sort((a, b) => b.rating - a.rating)
  .slice(0, 4);
---

<Layout title={movie.title}>
  <article class="movie-detail">
    <!-- 顶部导航 -->
    <nav class="top-nav">
      <a href="/" class="back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:4px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        返回首页
      </a>
      <span class="detail-no">{movie.publishedDate}</span>
    </nav>

    {/* Minified top nav with back link */}
    <nav class="detail-topbar">
      <a href="/" class="topbar-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>电影库</span>
      </a>
      <span class="topbar-date">{movie.publishedDate}</span>
    </nav>

    <!-- Hero -->
    <div class="hero-section">
      <div class="hero-cover-wrap">
        <div class="hero-cover" style={`background: ${movie.cover.bg}`}>
          <img src={movie.cover.url} alt={movie.title} loading="eager" decoding="async" referrerpolicy="no-referrer" onerror="this.src='/fallback-poster.svg'; this.classList.add('poster-loaded')" />
        </div>
        <span class="hero-stamp">TODAY</span>
      </div>
      <div class="hero-info">
        <h1>{movie.title}</h1>
        {movie.titleOriginal && <p class="original">{movie.titleOriginal}</p>}
        <div class="meta-grid">
          <span class="meta-pill">
            <span class="pill-label">评分</span>
            <span class="pill-value rating-val">{movie.rating}</span>
          </span>
          <span class="meta-pill">
            <span class="pill-label">年份</span>
            <span class="pill-value">{movie.year}</span>
          </span>
          <span class="meta-pill">
            <span class="pill-label">时长</span>
            <span class="pill-value">{movie.duration}分钟</span>
          </span>
          <span class="meta-pill">
            <span class="pill-label">类型</span>
            <span class="pill-value">{movie.type === 'tv' ? '电视剧' : '电影'}</span>
          </span>
        </div>
        <div class="genre-pills">
          {movie.genre.map(g => <span class="genre-pill">{g}</span>)}
        </div>
      </div>
    </div>

    {/* WhyThisMovie */}
    {movie.whyThisMovie && (
      <section class="why-section">
        <h2 class="section-title">为什么是这部</h2>
        <WhyThisMovie title={movie.title} reason={movie.whyThisMovie} />
      </section>
    )}

    <div class="content-sections">
      <!-- 导演 -->
      <DirectorCard director={movie.director} />

      <!-- 主演 -->
      <section>
        <h2>🌟 主演</h2>
        <CastList cast={movie.cast} />
      </section>

      {/* Today's Featured line */}
      <section class="synopsis-section">
        <h2 class="section-title">剧情简介</h2>
        <p class="synopsis">{movie.synopsis}</p>
      </section>

      {/* Gallery */}
      <section class="gallery-section">
        <h2 class="section-title">电影海报</h2>
        <PosterGallery posters={movie.posters} />
      </section>

      {/* Quotes */}
      <section class="quotes-section">
        <h2 class="section-title">经典语录</h2>
        <div class="quotes-grid">
          {movie.quotes.map(q => <QuoteCard quote={q} />)}
        </div>
      </section>

      {/* Similar movies */}
      {similarMovies.length > 0 && (
        <section class="similar-section">
          <h2 class="section-title">相似推荐</h2>
          <div class="similar-scroll">
            {similarMovies.map(m => (
              <a href={`/movie/${m.publishedDate}/`} class="similar-card">
                <div class="similar-cover" style={`background: ${m.cover.bg || '#333'}`}>
                  <img src={m.cover.url} alt={m.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.src='/fallback-poster.svg'; this.classList.add('poster-loaded')" />
                </div>
                <div class="similar-info">
                  <p class="similar-title">{m.title}</p>
                  <span class="similar-rating">⭐ {m.rating}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>

<style>
  .movie-detail {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px 60px;
    font-family: var(--font-body);
  }

  /* Top nav bar */
  .detail-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    margin-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }
  .topbar-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-secondary) !important;
    font-size: 0.9rem;
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .topbar-back:hover { color: var(--accent) !important; }

  .topbar-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
  }

  /* Hero */
  .hero-section {
    display: flex;
    gap: 32px;
    margin-bottom: 40px;
    animation: fadeIn 0.5s ease;
  }

  .hero-cover-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .hero-cover {
    width: 320px;
    height: 480px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(60, 30, 15, 0.15), 0 4px 16px rgba(0,0,0,0.08);
    transition: transform 0.3s ease;
  }
  .hero-cover:hover { transform: translateY(-4px); }

  .hero-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-stamp {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 4px 12px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    border-radius: 0;
    transform: rotate(-3deg);
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .original {
    font-size: 1.05rem;
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
  }

  /* Meta grid */
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .meta-pill {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.85rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .pill-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pill-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .rating-val {
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  /* Genre pills */
  .genre-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .genre-pill {
    padding: 0.25em 0.7em;
    background: var(--gold-soft);
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 999px;
    border: 1px solid rgba(212, 161, 58, 0.15);
  }

  /* Why section */
  .why-section {
    margin-bottom: 2.5rem;
  }

  /* 内容区 */
  .content-sections {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  section h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 16px;
    padding-bottom: 8px;
    padding-left: 0.5rem;
    border-bottom: none;
    border-left: 3px solid var(--gold);
  }

  .synopsis {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-primary);
    padding: 1.5rem;
    background: var(--bg-card);
    border-left: 4px solid var(--gold);
    border-radius: 0 var(--radius) var(--radius) 0;
    margin: 0;
    box-shadow: var(--shadow);
  }

  .quote-card {
    font-family: var(--font-display);
  }

  /* 相似电影推荐 */
  .similar-scroll {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .similar-scroll::-webkit-scrollbar {
    height: 4px;
  }

  .similar-scroll::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: 2px;
  }

  .similar-scroll::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  .similar-card {
    flex-shrink: 0;
    width: 160px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-card);
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
  }

  .similar-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .similar-cover {
    width: 100%;
    aspect-ratio: 2/3;
    overflow: hidden;
  }

  .similar-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .similar-info {
    padding: 10px;
  }

  .similar-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  .similar-rating {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (min-width: 641px) {
    .similar-card {
      width: 180px;
    }
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .hero-section {
      flex-direction: column;
      gap: 20px;
    }

    .hero-cover-wrap {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .hero-cover {
      width: 260px;
      height: 390px;
      flex-shrink: 0;
    }

    .hero-info h1 {
      font-size: 1.5rem;
    }

    .synopsis {
      padding: 1rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .movie-detail {
      padding: 0 12px 40px;
    }

    .hero-cover {
      width: 200px;
      height: 300px;
    }

    .meta {
      font-size: 0.85rem;
      gap: 8px;
    }

    .rating-badge {
      font-size: 0.9rem;
      padding: 4px 10px;
    }
  }

  @media (max-width: 360px) {
    .hero-cover {
      width: 170px;
      height: 255px;
    }

    .hero-info h1 {
      font-size: 1.3rem;
    }
  }
</style>
