---
import Layout from '../layouts/Layout.astro';
import { movies } from '../data/movies';
---

<Layout title="搜索电影">
  <main>
    <!-- 导航栏 -->
    <nav class="navbar">
      <a href="/" class="logo">🎬 每日电影</a>
      <div class="nav-links">
        <a href="/archive/">归档</a>
      </div>
    </nav>

    <header class="page-header">
      <h1>搜索电影</h1>
      <p>输入关键词搜索电影标题、导演、演员、类型</p>
    </header>

    <div class="search-box">
      <input
        type="search"
        id="search-input"
        placeholder="搜索电影标题、导演、演员..."
        autofocus
      />
    </div>

    <div id="search-results" class="search-results">
      <p class="hint">请输入关键词开始搜索</p>
    </div>
  </main>
</Layout>

<script define:vars={{ movies }}>
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');

  function renderMovie(movie) {
    return `
      <a href="/movie/${movie.publishedDate}/" class="movie-result">
        <div class="movie-info">
          <h3>${movie.title}</h3>
          ${movie.titleOriginal ? `<p class="original">${movie.titleOriginal}</p>` : ''}
          <p class="meta">导演：${movie.director.name} | ${movie.year} | ⭐ ${movie.rating}</p>
          <div class="genres">${movie.genre.map(g => `<span>${g}</span>`).join('')}</div>
        </div>
      </a>
    `;
  }

  function search(query) {
    if (!query.trim()) {
      results.innerHTML = '<p class="hint">请输入关键词开始搜索</p>';
      return;
    }

    const lowerQuery = query.toLowerCase();
    const matches = movies.filter(m => {
      return m.title.toLowerCase().includes(lowerQuery)
        || (m.titleOriginal && m.titleOriginal.toLowerCase().includes(lowerQuery))
        || m.director.name.toLowerCase().includes(lowerQuery)
        || m.cast.some(c => c.name.toLowerCase().includes(lowerQuery))
        || m.genre.some(g => g.toLowerCase().includes(lowerQuery));
    });

    if (matches.length === 0) {
      results.innerHTML = '<p class="no-results">未找到匹配的电影</p>';
    } else {
      results.innerHTML = `
        <p class="result-count">找到 ${matches.length} 部电影</p>
        ${matches.map(renderMovie).join('')}
      `;
    }
  }

  input.addEventListener('input', e => search(e.target.value));
</script>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  /* 导航栏 */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary) !important;
  }

  .logo:hover {
    color: var(--accent) !important;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--accent) !important;
  }

  .page-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .page-header p {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .search-box {
    margin-bottom: 32px;
  }

  #search-input {
    width: 100%;
    padding: 16px 20px;
    font-size: 1rem;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    background: var(--bg-secondary);
    color: var(--text-primary);
    transition: border-color 0.2s;
  }

  #search-input::placeholder {
    color: var(--text-secondary);
  }

  #search-input:focus {
    border-color: var(--accent);
  }

  .search-results {
    min-height: 200px;
  }

  .hint {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1rem;
    padding: 40px;
  }

  .no-results {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1rem;
    padding: 40px;
    background: var(--bg-secondary);
    border-radius: var(--radius);
  }

  .result-count {
    color: var(--text-secondary);
    margin-bottom: 16px;
    font-size: 0.85rem;
  }

  :global(.movie-result) {
    display: block;
    padding: 16px;
    background: var(--bg-card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  :global(.movie-result:hover) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  :global(.movie-info h3) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  :global(.movie-result .original) {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  :global(.movie-result .meta) {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  :global(.movie-result .genres) {
    display: flex;
    gap: 8px;
  }

  :global(.movie-result .genres span) {
    background: var(--bg-secondary);
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
</style>
