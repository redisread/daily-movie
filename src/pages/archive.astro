---
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';
import { movies } from '../data/movies';

const sortedMovies = movies.sort((a, b) => b.publishedDate.localeCompare(a.publishedDate));
---

<Layout title="电影归档">
  <main>
    <!-- 导航栏 -->
    <nav class="navbar">
      <a href="/" class="logo">🎬 每日电影</a>
      <div class="nav-links">
        <a href="/search/">搜索</a>
      </div>
    </nav>

    <header class="page-header">
      <h1>电影归档</h1>
      <p>共 {sortedMovies.length} 部电影</p>
    </header>

    <div class="archive-grid">
      {sortedMovies.map((movie, idx) => (
        <MovieCard movie={movie} delay={idx * 0.1} />
      ))}
    </div>
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  /* 导航栏 */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary) !important;
  }

  .logo:hover {
    color: var(--accent) !important;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--accent) !important;
  }

  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .page-header p {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  @media (max-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1025px) {
    .archive-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
