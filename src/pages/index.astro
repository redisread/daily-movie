---
import Layout from '../layouts/Layout.astro';
import TodayHero from '../components/TodayHero.astro';
import MovieList from '../components/MovieList.astro';
import MovieDetail from '../components/MovieDetail.astro';
import { movies } from '../data/movies';

const sortedMovies = movies;
const now = new Date();
const todayDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
const todayIndex = sortedMovies.findIndex((movie) => movie.publishedDate === todayDate);
const currentIndex = todayIndex >= 0 ? todayIndex : sortedMovies.length - 1;
const todayMovie = sortedMovies[currentIndex];
const pageTitle = `每日一影院 — ${todayMovie?.title ?? '今日放映'}`;
const pageDescription = todayMovie ? `${todayMovie.title} · ${todayMovie.director.name} · ${todayMovie.year}` : '每日一影院 — 每天一场放映仪式';
---

<Layout title={pageTitle} description={pageDescription} image={todayMovie?.cover.url}>
  <header class="app-header">
    <a class="brand" href="#" aria-label="返回今日放映">
      <span class="brand-mark" aria-hidden="true">◒</span>
      <span><strong>每日一影院</strong><small>DAILY MOVIE</small></span>
    </a>
    <nav class="app-nav" aria-label="主导航">
      <a href="#/" data-nav="home">今日放映</a>
      <a href="#/archive" data-nav="archive">电影库</a>
      <a href="#/about" data-nav="about">关于</a>
    </nav>
    <span class="header-count">{String(sortedMovies.length).padStart(2, '0')} FILMS</span>
  </header>

  <div class="spa-frame">
    {todayMovie && <TodayHero movie={todayMovie} dateStr={todayMovie.publishedDate} prevMovie={sortedMovies[currentIndex - 1]} nextMovie={sortedMovies[currentIndex + 1]} totalCount={sortedMovies.length} currentIndex={currentIndex} />}
    <MovieList movies={sortedMovies} />

    {sortedMovies.map((movie, index) => (
      <MovieDetail movie={movie} prevMovie={sortedMovies[index - 1]} nextMovie={sortedMovies[index + 1]} />
    ))}

    <section class="about-view" data-view="about" hidden aria-labelledby="about-title">
      <div class="about-copy">
        <p class="eyebrow">ABOUT THE PROJECT</p>
        <h1 id="about-title">每天遇见一部。</h1>
        <p>每日一影院是一个安静的电影收藏。没有评分，没有社交，也不急着解释——只是在每天的某个时刻，推开放映厅的门，坐下，等银幕亮起来。</p>
        <p>每部电影对应一篇 Markdown 文档。标题、海报、简介和多条语录都在同一个文件里，新增一部电影，就新增一篇文档。</p>
        <a class="about-back" href="#/">回到今日放映 →</a>
      </div>
    </section>
  </div>

  <footer class="app-footer">
    <span>© {new Date().getFullYear()} DAILY MOVIE</span>
    <span>一部电影，一次放映</span>
  </footer>
</Layout>

<script>
  const views = [...document.querySelectorAll<HTMLElement>('[data-view]')];
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const search = document.querySelector<HTMLInputElement>('[data-movie-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-movie-card]')];
  const resultCount = document.querySelector<HTMLElement>('[data-archive-count]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');

  function getRoute() {
    const hash = window.location.hash.replace(/^#/, '') || '/';
    return hash.startsWith('/') ? hash : `/${hash}`;
  }

  function renderRoute() {
    const route = getRoute();
    const detailDate = route.startsWith('/movie/') ? route.slice('/movie/'.length).replace(/\/$/, '') : '';
    const routeName = detailDate ? 'detail' : route === '/archive' ? 'archive' : route === '/about' ? 'about' : 'home';

    views.forEach((view) => {
      const isDetail = view.dataset.view === 'detail';
      const active = isDetail ? view.dataset.movieDate === detailDate : view.dataset.view === routeName;
      view.hidden = !active;
    });

    navLinks.forEach((link) => {
      const active = link.dataset.nav === routeName || (routeName === 'detail' && link.dataset.nav === 'archive');
      link.toggleAttribute('aria-current', active);
      link.hidden = routeName === 'detail' && link.dataset.nav === 'home';
    });

    document.title = routeName === 'archive' ? '电影库 — 每日一影院' : routeName === 'about' ? '关于 — 每日一影院' : document.title;
    window.scrollTo({ top: 0, behavior: 'auto' });
  }

  function filterMovies() {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.dataset.searchText ?? '').toLocaleLowerCase().includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (resultCount) resultCount.textContent = String(visible);
    if (noResults) noResults.hidden = visible > 0;
  }

  window.addEventListener('hashchange', renderRoute);
  search?.addEventListener('input', filterMovies);
  renderRoute();
</script>

<style>
  :global(:root) { --page-gutter: clamp(1.15rem, 4vw, 4rem); }
  :global(body) { overflow-x: hidden; }
  .app-header { position: sticky; top: 0; z-index: 10; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; min-height: 5.5rem; padding: 0 var(--page-gutter); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--paper) 94%, transparent); backdrop-filter: blur(12px); }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; justify-self: start; color: var(--ink); }
  .brand:hover { border-bottom-color: transparent; }
  .brand-mark { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; color: var(--gold); font-size: 1.45rem; }
  .brand span:last-child { display: grid; gap: 0.1rem; }
  .brand strong { font-size: 1rem; font-weight: 500; }
  .brand small { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.16em; }
  .app-nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  .app-nav a { position: relative; padding: 0.8rem 0; color: var(--text-muted); font-size: 0.83rem; }
  .app-nav a:hover, .app-nav a[aria-current] { color: var(--ink); border-bottom-color: transparent; }
  .app-nav a[aria-current]::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 1px; background: var(--gold); content: ''; }
  .header-count { justify-self: end; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; }
  .spa-frame { min-height: calc(100vh - 5.5rem); }
  .about-view { display: grid; place-items: center; min-height: calc(100vh - 11rem); padding: 5rem var(--page-gutter); }
  .about-copy { max-width: 42rem; }
  .eyebrow { margin: 0; color: var(--gold); font-size: var(--size-label); letter-spacing: 0.15em; }
  .about-copy h1 { margin-top: 1rem; font-size: clamp(3.5rem, 9vw, 8rem); line-height: 0.95; letter-spacing: -0.06em; }
  .about-copy p:not(.eyebrow) { max-width: 34rem; margin: 2rem 0 0; color: var(--text-muted); font-size: 1.08rem; line-height: 2; }
  .about-back { display: inline-block; margin-top: 2.5rem; color: var(--ink); }
  .about-back:hover { color: var(--gold); }
  .app-footer { display: flex; justify-content: space-between; gap: 1rem; max-width: 76rem; margin: 0 auto; padding: 1.2rem var(--page-gutter) 2rem; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.7rem; letter-spacing: 0.05em; }
  :global([hidden]) { display: none !important; }

  @media (max-width: 700px) {
    .app-header { grid-template-columns: 1fr auto; min-height: 4.6rem; }
    .app-nav { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; width: 100%; margin-top: -0.5rem; }
    .header-count { display: none; }
    .app-header:has(.app-nav) { padding-bottom: 0.4rem; }
    .app-footer { flex-direction: column; }
  }
</style>
