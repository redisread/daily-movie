---
import Layout from '../layouts/Layout.astro';
import HeroCinema from '../components/HeroCinema.astro';
import MovieDetailRitual from '../components/MovieDetailRitual.astro';
import { movies } from '../data/movies';
import type { Movie } from '../schemas/movie';

// 今日日期
const today = new Date();
const dateStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// 按 publishedDate 排序，确保上一部/下一部稳定
const sortedMovies = [...movies].sort((a, b) =>
  a.publishedDate.localeCompare(b.publishedDate)
);

const todayIndex = sortedMovies.findIndex((m) => m.publishedDate === dateStr);
const todayMovie = todayIndex >= 0 ? sortedMovies[todayIndex] : sortedMovies[sortedMovies.length - 1];
const actualIndex = todayIndex >= 0 ? todayIndex : sortedMovies.length - 1;

const prevMovie = sortedMovies[actualIndex - 1];
const nextMovie = sortedMovies[actualIndex + 1];

// archive lite：按年份/月份分组
const grouped = new Map<string, Movie[]>();
sortedMovies.forEach((m) => {
  const [year, month] = m.publishedDate.split('-');
  const key = `${year}-${month}`;
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(m);
});
const archiveGroups = Array.from(grouped.entries()).sort((a, b) => b[0].localeCompare(a[0]));

const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

function formatMonthYear(key: string) {
  const [year, month] = key.split('-');
  const mIdx = parseInt(month, 10) - 1;
  return { year, month: monthNames[mIdx] ?? month };
}

const pageTitle = `每日一影院 — ${todayMovie?.title ?? '今日放映'}`;
const pageDescription = todayMovie
  ? `${todayMovie.title} · ${todayMovie.director.name} · ${todayMovie.year}`
  : '每日一影院 — 每天一场放映仪式';
---

<Layout title={pageTitle} description={pageDescription}>
  {
    todayMovie && (
      <>
        <HeroCinema
          movie={todayMovie}
          dateStr={dateStr}
          mode="home"
          prevMovie={prevMovie}
          nextMovie={nextMovie}
          totalCount={sortedMovies.length}
          currentIndex={actualIndex}
        />

        <MovieDetailRitual movie={todayMovie} showPermalink />
      </>
    )
  }

  <section id="archive" class="archive-section" aria-labelledby="archive-title">
    <div class="archive-content">
      <p class="archive-eyebrow">ALL FILMS</p>
      <h2 id="archive-title" class="archive-title">历史放映</h2>
      <p class="archive-subtitle">
        <span>自 {sortedMovies[sortedMovies.length - 1]?.year ?? ''} 年起，{sortedMovies.length} 部</span>
        {todayMovie && (
          <span class="archive-current">
            <a href="#today">今日放映《{todayMovie.title}》</a>
          </span>
        )}
      </p>

      <nav class="archive-index" aria-label="月份索引">
        {archiveGroups.map(([key]) => {
          const { year, month } = formatMonthYear(key);
          return (
            <a href={`#archive-${key}`}>
              <span>{month}</span>
              <span>{year}</span>
            </a>
          );
        })}
      </nav>

      <div class="archive-timeline">
        {archiveGroups.map(([key, group]) => {
          const { year, month } = formatMonthYear(key);
          return (
            <div id={`archive-${key}`} class="timeline-group">
              <div class="timeline-header">
                <span class="timeline-year">{year}</span>
                <span class="timeline-month">{month}</span>
              </div>
              <ul class="timeline-list">
                {group
                  .sort((a, b) => b.publishedDate.localeCompare(a.publishedDate))
                  .map((m) => (
                    <li
                      class:list={['timeline-item', { 'is-today': m.publishedDate === todayMovie?.publishedDate }]}
                      aria-current={m.publishedDate === todayMovie?.publishedDate ? 'date' : undefined}
                    >
                      <span class="timeline-day">{m.publishedDate.slice(8)}</span>
                      {m.publishedDate === todayMovie?.publishedDate && (
                        <span class="timeline-today">今日放映</span>
                      )}
                      <a href={`/movie/${m.publishedDate}/`} class="timeline-title">《{m.title}》</a>
                    </li>
                  ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section id="about" class="about-section" aria-labelledby="about-title">
    <div class="about-content">
      <p class="about-eyebrow">ABOUT</p>
      <h2 id="about-title" class="about-title">每日一影院</h2>

      <div class="about-text">
        <p>每天推荐一部经典电影的小项目。</p>
        <p>不评分，不社交，不解释。只是每天遇见一部。</p>
        <p>推开放映厅的门，坐下，灯暗了，银幕亮了。</p>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <nav class="footer-nav" aria-label="页面导航">
      <a href="#today">今日放映</a>
      <a href="#archive">历史放映</a>
      <a href="#about">关于</a>
    </nav>
    <p>© {new Date().getFullYear()} 每日一影院 · DAILY MOVIE</p>
  </footer>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Archive section ─── */
  .archive-section {
    min-height: 100vh;
    padding: var(--pad-v) var(--pad-h);
    background: var(--paper);
  }

  .archive-content {
    max-width: 46rem;
    margin: 0 auto;
  }

  .archive-eyebrow {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: 1rem;
  }

  .archive-title {
    font-size: var(--size-detail);
    font-weight: 500;
    text-align: center;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .archive-subtitle {
    font-size: var(--size-caption);
    font-style: italic;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .archive-current {
    font-style: normal;
  }

  .archive-current a {
    border-bottom: 1px solid var(--gold-deep);
    padding-bottom: 1px;
    transition: scale 150ms ease-out, border-color 0.2s ease, color 0.2s ease;
  }

  .archive-current a:hover {
    color: var(--gold-deep);
  }

  .archive-current a:active {
    scale: 0.96;
  }

  .archive-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .archive-index a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.35rem 0;
    font-size: var(--size-caption);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: scale 150ms ease-out, border-color 0.2s ease, color 0.2s ease;
  }

  .archive-index a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .archive-index a:active {
    scale: 0.96;
  }

  .archive-index span:first-child {
    font-weight: 500;
  }

  .archive-timeline {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .timeline-group {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 2rem;
    scroll-margin-top: 2rem;
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    padding-top: 0.25rem;
  }

  .timeline-year {
    font-size: var(--size-caption);
    font-style: italic;
    color: var(--text-muted);
  }

  .timeline-month {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--ink);
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .timeline-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 1.125rem;
  }

  .timeline-item.is-today .timeline-day {
    color: var(--gold-deep);
  }

  .timeline-today {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--gold-deep);
  }

  .timeline-day {
    font-variant-numeric: tabular-nums;
    font-size: var(--size-caption);
    color: var(--text-muted);
    min-width: 1.5rem;
  }

  .timeline-title {
    font-style: italic;
    border-bottom: 1px solid transparent;
    transition: scale 150ms ease-out, border-bottom-color 0.2s ease;
  }

  .timeline-title:hover {
    border-bottom-color: var(--ink);
  }

  .timeline-title:active {
    scale: 0.96;
  }

  /* ─── About section ─── */
  .about-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--pad-v) var(--pad-h);
    background: var(--paper);
  }

  .about-content {
    max-width: 36rem;
    text-align: center;
  }

  .about-eyebrow {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .about-title {
    font-size: var(--size-detail);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 3rem;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-size: var(--size-body);
    line-height: 1.9;
    color: var(--ink);
  }

  /* ─── Footer ─── */
  .site-footer {
    padding: 2.5rem var(--pad-h) 3rem;
    text-align: center;
    background: var(--paper);
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-size: var(--size-caption);
    letter-spacing: 0.08em;
  }

  .footer-nav a {
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: scale 150ms ease-out, border-bottom-color 0.2s ease, color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .footer-nav a:active {
    scale: 0.96;
  }

  .site-footer p {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .detail-meta {
      flex-direction: column;
      gap: 1.5rem;
    }

    .timeline-group {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .timeline-header {
      align-items: flex-start;
      flex-direction: row;
      gap: 0.75rem;
    }

    .timeline-day {
      min-width: 1.5rem;
    }
  }
</style>
