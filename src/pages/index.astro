---
import Layout from '../layouts/Layout.astro';
import WhyThisMovie from '../components/WhyThisMovie.astro';
import { movies } from '../data/movies';

// 获取今日推荐（按 publishedDate 倒序第一本）
const todayMovie = movies[0];

// 所有电影 ID（用于「换一部」随机切换）
const allMovieIds = movies.map(m => m.id);
const moviesJson = JSON.stringify(movies.map(m => ({ id: m.id, title: m.title, titleOriginal: m.titleOriginal, cover: m.cover, genre: m.genre, rating: m.rating, quotes: m.quotes.slice(0, 3) })));

// 是否启用微动海报（桌面端 + 有视频时）
// 用 client script 动态判断视口，不在 SSR 阶段假定
const initialHasVideo = Boolean(todayMovie?.cover.video);

// 格式化今日日期
const today = new Date();
const dateStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
---

<Layout title={`每日一影院 — ${todayMovie?.title ?? ''}`} fullscreen>
  <main class="cinema" data-movies={moviesJson} data-current={todayMovie?.id ?? ''}>
    <!-- 红幕光晕背景 -->
    <div class="spotlight" aria-hidden="true"></div>

    <!-- 暗角 -->
    <div class="vignette" aria-hidden="true"></div>

    <!-- 顶部极简信息 -->
    <header class="cinema-header">
      <span class="brand">每日一影院</span>
      <time class="date">{dateStr}</time>
    </header>

    {todayMovie && (
      <div class="stage" data-movie-id={todayMovie.id} data-has-video={initialHasVideo}>
        <!-- 海报（支持微动预览视频） -->
        <figure class="poster">
          <div class="poster-frame" style={`background: ${todayMovie.cover.bg}`}>
            {initialHasVideo ? (
              <video
                class="poster-video"
                src={todayMovie.cover.video}
                poster={todayMovie.cover.url}
                muted
                autoplay
                loop
                playsinline
                preload="metadata"
                aria-label={todayMovie.title}
              ></video>
            ) : (
              <img
                src={todayMovie.cover.url}
                alt={todayMovie.title}
                class="poster-img"
                onerror="this.src='/fallback-poster.svg'"
                fetchpriority="high"
              />
            )}
          </div>
        </figure>

        <!-- 金句 -->
        <blockquote class="quote">
          <p class="quote-text" data-quotes={JSON.stringify(todayMovie.quotes.map(q => q.text).slice(0, 5))}>
            「{todayMovie.quotes[0]?.text}」
          </p>
          {todayMovie.quotes[0]?.speaker && (
            <cite class="quote-speaker">— {todayMovie.quotes[0].speaker}</cite>
          )}
        </blockquote>

        <!-- Why This Movie (curation) -->
        {todayMovie.whyThisMovie && (
          <WhyThisMovie title={todayMovie.title} reason={todayMovie.whyThisMovie} />
        )}

        <!-- CTA -->
        <div class="actions">
          <button type="button" class="btn-primary" id="btn-next">
            <span class="btn-icon">▶</span>
            <span class="btn-text">换一部</span>
          </button>
          <a
            href={`/movie/${todayMovie.publishedDate}/`}
            class="btn-secondary"
          >
            <span>去看这部电影</span>
            <span class="btn-arrow">→</span>
          </a>
        </div>
      </div>
    )}

    <!-- 底部信息（极简） -->
    <footer class="cinema-footer">
      <span class="movie-title-minimal">{todayMovie?.title}</span>
      <span class="divider">·</span>
      <span>{todayMovie?.rating ? `⭐ ${todayMovie.rating}` : ''}</span>
      <span class="divider">·</span>
      <span>{todayMovie?.genre?.join(' / ')}</span>
    </footer>
  </main>
</Layout>

<script>
  // 「换一部」逻辑 + 视频/图片切换 + 移动端降级 + Anti-Repeat

  // ── Inline history helpers (from src/lib/history.ts) ──
  const HISTORY_KEY = "daily-movie-shown-history";
  const HISTORY_LIMIT = 30;
  const HISTORY_TTL_MS = 30 * 24 * 60 * 60 * 1000;

  function getHistory(): { id: string; shownAt: number }[] {
    try {
      const raw = localStorage.getItem(HISTORY_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      const cutoff = Date.now() - HISTORY_TTL_MS;
      return parsed.filter((e: any) => e && typeof e.id === "string" && e.shownAt >= cutoff);
    } catch { return []; }
  }

  function getHistoryIds(): Set<string> {
    return new Set(getHistory().map(e => e.id));
  }

  function addToHistory(id: string): void {
    try {
      const current = getHistory().filter(e => e.id !== id);
      current.push({ id, shownAt: Date.now() });
      const trimmed = current.slice(-HISTORY_LIMIT);
      localStorage.setItem(HISTORY_KEY, JSON.stringify(trimmed));
    } catch { /* ignore */ }
  }

  const stage = document.querySelector('.stage') as HTMLElement | null;
  if (stage) {
    const moviesData = JSON.parse(stage.parentElement!.dataset.movies || '[]');
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement | null;
    const quoteText = document.querySelector('.quote-text') as HTMLElement | null;
    const moviePoster = stage.querySelector('.poster-frame') as HTMLElement | null;
    const whyEl = document.querySelector('.why-this-movie') as HTMLElement | null;

    // 移动端降级：< 768px 不加载视频，节省流量
    const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

    // 替换媒体元素：img <-> video
    function setMedia(coverUrl: string, videoUrl: string | null) {
      if (!moviePoster) return;
      const existing = moviePoster.querySelector('.poster-img, .poster-video');
      const useVideo = !!videoUrl && !isMobile();

      if (useVideo) {
        if (existing && existing.tagName === 'VIDEO') {
          (existing as HTMLVideoElement).src = videoUrl;
          (existing as HTMLVideoElement).poster = coverUrl;
          (existing as HTMLVideoElement).load();
          (existing as HTMLVideoElement).play().catch(() => {});
        } else {
          if (existing) existing.remove();
          const v = document.createElement('video');
          v.className = 'poster-video';
          v.src = videoUrl;
          v.poster = coverUrl;
          v.muted = true;
          v.autoplay = true;
          v.loop = true;
          v.playsInline = true;
          v.preload = 'metadata';
          v.setAttribute('aria-label', stage.querySelector('.cinema-header')?.textContent || '');
          moviePoster.appendChild(v);
        }
      } else {
        if (existing && existing.tagName === 'IMG') {
          (existing as HTMLImageElement).src = coverUrl;
        } else {
          if (existing) existing.remove();
          const img = document.createElement('img');
          img.className = 'poster-img';
          img.src = coverUrl;
          img.alt = stage.querySelector('.cinema-footer')?.textContent || '';
          img.setAttribute('fetchpriority', 'high');
          img.onerror = () => { img.src = '/fallback-poster.svg'; };
          moviePoster.appendChild(img);
        }
      }
    }

    // Anti-Repeat: 选一部不在历史中的电影
    function pickMovie(): any {
      const currentId = stage!.dataset.movieId;
      const seenIds = getHistoryIds();

      // 排除当前 + 历史
      let available = moviesData.filter((m: any) => m.id !== currentId && !seenIds.has(m.id));

      // 边界：如果全部都在历史中，取最早展示的（重新轮换）
      if (available.length === 0) {
        available = moviesData.filter((m: any) => m.id !== currentId);
      }

      if (available.length === 0) return null;

      return available[Math.floor(Math.random() * available.length)];
    }

    btnNext?.addEventListener('click', () => {
      const pick = pickMovie();
      if (!pick) return;

      // 更新 URL 不刷新（SPA 式切换）
      stage.dataset.movieId = pick.id;
      stage.dataset.hasVideo = String(Boolean(pick.cover.video));
      if (moviePoster) {
        moviePoster.style.background = pick.cover.bg;
      }
      setMedia(pick.cover.url, pick.cover.video || null);

      if (quoteText && pick.quotes?.length > 0) {
        const q = pick.quotes[Math.floor(Math.random() * pick.quotes.length)];
        quoteText.textContent = `「${q}」`;
      }

      // WhyThisMovie 更新（带淡入 + 折叠状态保持）
      const whyContent = document.getElementById('why-content');
      const whyToggle = document.getElementById('why-toggle');
      if (whyContent && whyToggle) {
        const wasExpanded = whyToggle.getAttribute('aria-expanded') === 'true';
        // 先折叠
        whyContent.style.opacity = '0';
        setTimeout(() => {
          whyContent.setAttribute('hidden', '');
          whyToggle.setAttribute('aria-expanded', 'false');
          // 更新内容
          const titleEl = whyContent.querySelector('.why-title');
          const textEl = whyContent.querySelector('.why-text');
          if (titleEl) titleEl.textContent = `《${pick.title}》`;
          if (textEl) textEl.textContent = pick.whyThisMovie || '';
          // 如果之前是展开的，重新展开
          if (wasExpanded && pick.whyThisMovie) {
            whyContent.removeAttribute('hidden');
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                whyContent.style.opacity = '0.75';
              });
            });
            whyToggle.setAttribute('aria-expanded', 'true');
          }
        }, 200);
      }

      // 更新 footer 信息
      const footerSpans = document.querySelectorAll('.cinema-footer span');
      if (footerSpans[0]) footerSpans[0].textContent = pick.title;
      if (footerSpans[2]) footerSpans[2].textContent = pick.rating ? `⭐ ${pick.rating}` : '';
      if (footerSpans[4]) footerSpans[4].textContent = pick.genre?.join(' / ') || '';

      // 切换动画
      stage.classList.add('switching');
      setTimeout(() => stage.classList.remove('switching'), 300);

      // 更新 CTA 链接
      const ctaLink = stage.querySelector('.btn-secondary') as HTMLAnchorElement | null;
      if (ctaLink) {
        ctaLink.href = `/movie/${pick.id}/`;
      }

      // Anti-Repeat: 记录到历史
      addToHistory(pick.id);
    });

    // 视口变化时响应：跨移动端 ↔ 桌面端时切换媒体类型
    const mobileQuery = window.matchMedia('(max-width: 767px)');
    const handleBreakpoint = () => {
      const currentStage = document.querySelector('.stage') as HTMLElement | null;
      if (!currentStage) return;
      const currentId = currentStage.dataset.movieId;
      const current = moviesData.find((m: any) => m.id === currentId);
      if (!current) return;
      setMedia(current.cover.url, current.cover.video || null);
    };
    mobileQuery.addEventListener?.('change', handleBreakpoint);
  }
</script>

<style>
  /* 全屏电影院模式 */
  :global(body) {
    background: #0a0a0a;
    color: #e8d5b0;
    overflow: hidden;
  }

  .cinema {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  /* 红幕光晕 */
  .spotlight {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(139, 0, 0, 0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 50% 100%, rgba(0, 0, 0, 0.4) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  /* 暗角 */
  .vignette {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* 顶部信息 */
  .cinema-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    z-index: 10;
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #c8a86e;
  }

  /* 主舞台 */
  .stage {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    max-width: 560px;
    width: 100%;
    text-align: center;
  }

  /* 海报 */
  .poster {
    margin: 0;
    width: 260px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(200, 168, 110, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .poster:hover {
    transform: scale(1.02);
    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(200, 168, 110, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .poster-frame {
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 12px;
    overflow: hidden;
    transition: background 0.5s ease;
  }

  .poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  .poster-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 金句 */
  .quote {
    margin: 0;
    padding: 1.5rem 1rem;
    max-width: 480px;
    min-height: 80px;
  }

  .quote-text {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #f0e6cc;
    font-weight: 500;
    margin: 0 0 0.5rem;
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .quote-speaker {
    font-size: 0.85rem;
    color: #a89070;
    font-style: normal;
  }

  /* 按钮 */
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.8rem;
    border-radius: 100px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #c8a86e 0%, #a88a4e 100%);
    color: #0a0a0a;
    box-shadow: 0 4px 20px rgba(200, 168, 110, 0.3);
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #dcc08e 0%, #c8a86e 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(200, 168, 110, 0.4);
  }

  .btn-secondary {
    background: transparent;
    color: #e8d5b0;
    border: 1px solid rgba(200, 168, 110, 0.4);
  }

  .btn-secondary:hover {
    background: rgba(200, 168, 110, 0.1);
    border-color: rgba(200, 168, 110, 0.7);
    transform: translateY(-2px);
  }

  .btn-icon {
    font-size: 0.9rem;
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* 底部极简信息 */
  .cinema-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    z-index: 10;
    font-size: 0.8rem;
    opacity: 0.5;
  }

  .movie-title-minimal {
    font-weight: 600;
    color: #c8a86e;
  }

  .divider {
    opacity: 0.3;
  }

  /* 切换动画 */
  .switching .poster {
    animation: posterSwitch 0.3s ease;
  }

  .switching .quote-text {
    animation: quoteFade 0.3s ease;
  }

  @keyframes posterSwitch {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.95); opacity: 0.8; }
    100% { transform: scale(1); opacity: 1; }
  }

  @keyframes quoteFade {
    0% { opacity: 1; }
    50% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* ── 减法模式：弱化金句 ── */
  .quote {
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .quote:hover {
    opacity: 0.85;
  }

  /* ── Staggered 加载：首屏只有海报+电影名 ── */
  .quote,
  .why-this-movie-wrapper,
  .actions,
  .cinema-footer {
    animation: staggerIn 0.5s ease-out both;
  }

  .quote {
    animation-delay: 0.3s;
  }

  .why-this-movie-wrapper {
    animation-delay: 0.5s;
  }

  .actions {
    animation-delay: 0.7s;
  }

  .cinema-footer {
    animation-delay: 0.9s;
  }

  @keyframes staggerIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── 移动端：换一部图标化 ── */
  @media (max-width: 767px) {
    /* 移动端禁用微动视频，节省流量 */
    .poster-video {
      display: none;
    }

    /* 换一部 → 图标按钮 */
    .btn-primary {
      padding: 0.7rem;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-primary .btn-text {
      display: none;
    }

    .btn-primary .btn-icon {
      font-size: 1.2rem;
      margin: 0;
    }
  }

  @media (max-width: 640px) {
    .poster {
      width: 200px;
    }

    .quote-text {
      font-size: 1rem;
    }

    .btn-secondary {
      padding: 0.8rem 1.4rem;
      font-size: 0.9rem;
    }

    .cinema {
      padding: 1rem;
    }
  }
</style>
