---
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';
import { movies } from '../data/movies';

// 获取今日推荐（按 publishedDate 倒序第一本）
const todayMovie = movies[0];

// 格式化今日日期
const today = new Date();
const dateStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// 获取今日所有金句作为 JSON
const todayQuotes = todayMovie?.quotes || [];
const quotesJson = JSON.stringify(todayQuotes);
---

<Layout title="今日电影">
  <main>
    <!-- 日期显示 -->
    <p class="date-display">📅 {dateStr}</p>

    <!-- 今日推荐 - 金句轮播 -->
    <section class="today-recommendation">
      {todayMovie && todayQuotes.length > 0 ? (
        <div class="quote-carousel" data-quotes={quotesJson}>
          <!-- 金句区域 -->
          <div class="quote-slides">
            {todayQuotes.map((quote, idx) => (
              <div class="quote-slide" data-index={idx} class:list={[{ 'active': idx === 0 }]}>
                <blockquote class="quote-text">
                  「{quote.text}」
                </blockquote>
                <p class="quote-speaker">— {quote.speaker || '未知'}</p>
              </div>
            ))}
          </div>

          <!-- 指示器 -->
          <div class="quote-dots">
            {todayQuotes.map((_, idx) => (
              <button
                class="dot"
                data-index={idx}
                class:list={[{ 'active': idx === 0 }]}
                aria-label={`金句 ${idx + 1}`}
              />
            ))}
          </div>

          <!-- 电影信息 -->
          <div class="quote-info">
            <p class="quote-movie">《{todayMovie.title}》</p>
            <div class="quote-meta">
              <span>📅 {todayMovie.publishedDate}</span>
              <span>⭐ {todayMovie.rating}</span>
              <span>⏱ {todayMovie.duration}分钟</span>
            </div>
            <div class="quote-submeta">
              <span>🎭 {todayMovie.genre.join(' / ')}</span>
              <span>🎬 {todayMovie.director.name}</span>
            </div>
            <a href={`/movie/${todayMovie.publishedDate}/`} class="quote-cta">查看详情 →</a>
          </div>
        </div>
      ) : (
        <p class="no-movie">暂无推荐电影</p>
      )}
    </section>

    <!-- 电影库 -->
    <section class="movie-library">
      <div class="section-header">
        <h2>电影库</h2>
        <span class="counter">共 {movies.length} 部</span>
      </div>
      <div class="movies-grid">
        {movies.map((movie, idx) => (
          <MovieCard movie={movie} delay={idx * 0.1} />
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  // 金句轮播
  const carousel = document.querySelector('.quote-carousel');
  if (carousel) {
    const slides = carousel.querySelectorAll('.quote-slide');
    const dots = carousel.querySelectorAll('.dot');
    let currentIndex = 0;
    const total = slides.length;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    let touchStartX = 0;
    let touchEndX = 0;

    function goTo(index: number) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === currentIndex);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentIndex);
      });
    }

    function next() {
      goTo(currentIndex + 1);
    }

    function startAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      autoplayTimer = setInterval(next, 5000);
    }

    function resetAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      startAutoplay();
    }

    // 指示器点击
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goTo(idx);
        resetAutoplay();
      });
    });

    // 触摸滑动
    carousel.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) next();
        else goTo(currentIndex - 1);
        resetAutoplay();
      }
    }, { passive: true });

    // 启动自动轮播
    if (total > 1) startAutoplay();
  }
</script>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  /* 日期显示 */
  .date-display {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 32px;
  }

  /* 今日推荐 - 金句轮播 */
  .today-recommendation {
    margin-bottom: 60px;
  }

  .quote-carousel {
    position: relative;
    text-align: center;
    padding: 60px 20px;
  }

  .quote-slides {
    position: relative;
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quote-slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .quote-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .quote-text {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .quote-speaker {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* 指示器 */
  .quote-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 20px 0 24px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--border);
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
    padding: 0;
  }

  .dot.active {
    background: var(--accent);
    transform: scale(1.3);
  }

  .dot:hover {
    background: var(--text-secondary);
  }

  .dot.active:hover {
    background: var(--accent-hover);
  }

  /* 电影信息 */
  .quote-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .quote-movie {
    font-size: 1.1rem;
    color: var(--text-primary);
  }

  .quote-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .quote-submeta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .quote-cta {
    display: inline-block;
    margin-top: 8px;
    padding: 12px 24px;
    background: var(--accent);
    color: var(--bg-primary) !important;
    font-weight: 600;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .quote-cta:hover {
    background: var(--accent-hover) !important;
  }

  .no-movie {
    text-align: center;
    padding: 40px;
    background: var(--bg-secondary);
    border-radius: var(--radius);
    color: var(--text-secondary);
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .quote-carousel {
      padding: 40px 16px;
    }
    .quote-slides {
      min-height: 100px;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .quote-carousel {
      padding: 60px 20px;
    }
  }

  @media (min-width: 1025px) {
    .quote-carousel {
      padding: 80px 20px;
    }
  }

  /* 电影库 */
  .movie-library {
    margin-bottom: 60px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .counter {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  @media (max-width: 640px) {
    .movies-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .movies-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1025px) {
    .movies-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
