---
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import { movies } from '../data/movies';

// 获取今日推荐（按 publishedDate 倒序第一本）
const todayMovie = movies[0];

// 格式化今日日期
const today = new Date();
const dateStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
---

<Layout title="今日电影">
  <main>
    <!-- 导航栏 -->
    <nav class="navbar">
      <a href="/" class="logo">🎬 每日电影</a>
      <div class="nav-links">
        <a href="/archive/">归档</a>
        <a href="/search/">搜索</a>
      </div>
    </nav>

    <!-- 日期显示 -->
    <p class="date-display">📅 {dateStr}</p>

    <!-- 今日推荐 -->
    <section class="today-recommendation">
      {todayMovie ? (
        <FeaturedCard movie={todayMovie} />
      ) : (
        <p class="no-movie">暂无推荐电影</p>
      )}
    </section>

    <!-- 电影库 -->
    <section class="movie-library">
      <div class="section-header">
        <h2>电影库</h2>
        <span class="counter">共 {movies.length} 部</span>
      </div>
      <div class="movies-grid">
        {movies.map((movie, idx) => (
          <MovieCard movie={movie} delay={idx * 0.1} />
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  /* 导航栏 */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary) !important;
  }

  .logo:hover {
    color: var(--accent) !important;
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--accent) !important;
  }

  /* 日期显示 */
  .date-display {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 32px;
  }

  /* 今日推荐 */
  .today-recommendation {
    margin-bottom: 60px;
  }

  .no-movie {
    text-align: center;
    padding: 40px;
    background: var(--bg-secondary);
    border-radius: var(--radius);
    color: var(--text-secondary);
  }

  /* 电影库 */
  .movie-library {
    margin-bottom: 60px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .counter {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .movies-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .movies-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1025px) {
    .movies-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
