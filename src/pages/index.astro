---
import Layout from '../layouts/Layout.astro';
import MovieCard from '../components/MovieCard.astro';
import { movies } from '../data/movies';

// 获取今日推荐（按 publishedDate 倒序第一本）
const todayMovie = movies[0];

// 格式化今日日期
const today = new Date();
const dateStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// 获取今日金句（quotes 第一条）
const todayQuote = todayMovie?.quotes?.[0];
---

<Layout title="今日电影">
  <main>
    <!-- 导航栏 -->
    <nav class="navbar">
      <a href="/" class="logo">🎬 每日电影</a>
      <div class="nav-links">
        <a href="/archive/">归档</a>
        <a href="/search/">搜索</a>
      </div>
    </nav>

    <!-- 日期显示 -->
    <p class="date-display">📅 {dateStr}</p>

    <!-- 今日推荐 -->
    <section class="today-recommendation">
      {todayMovie && todayQuote ? (
        <div class="quote-hero">
          <blockquote class="quote-text" style="animation-delay: 0.3s">
            「{todayQuote.text}」
          </blockquote>
          <p class="quote-movie" style="animation-delay: 0.6s">《{todayMovie.title}》</p>
          {todayQuote.speaker && <p class="quote-speaker" style="animation-delay: 0.7s">— {todayQuote.speaker}</p>}
          <div class="quote-meta" style="animation-delay: 0.9s">
            <span>📅 {todayMovie.publishedDate}</span>
            <span>⭐ {todayMovie.rating}</span>
            <span>⏱ {todayMovie.duration}分钟</span>
          </div>
          <div class="quote-submeta" style="animation-delay: 1.0s">
            <span>🎭 {todayMovie.genre.join(' / ')}</span>
            <span>🎬 {todayMovie.director.name}</span>
          </div>
          <a href={`/movie/${todayMovie.publishedDate}/`} class="quote-cta" style="animation-delay: 1.2s">查看详情 →</a>
        </div>
      ) : (
        <p class="no-movie">暂无推荐电影</p>
      )}
    </section>

    <!-- 电影库 -->
    <section class="movie-library">
      <div class="section-header">
        <h2>电影库</h2>
        <span class="counter">共 {movies.length} 部</span>
      </div>
      <div class="movies-grid">
        {movies.map((movie, idx) => (
          <MovieCard movie={movie} delay={idx * 0.1} />
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  /* 导航栏 */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary) !important;
  }

  .logo:hover {
    color: var(--accent) !important;
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--accent) !important;
  }

  /* 日期显示 */
  .date-display {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 32px;
  }

  /* 今日推荐 - 金句 */
  .today-recommendation {
    margin-bottom: 60px;
  }

  .quote-hero {
    text-align: center;
    padding: 60px 20px;
  }

  .quote-text {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
    line-height: 1.6;
    margin-bottom: 16px;
    animation: fadeIn 1s ease backwards;
  }

  .quote-movie {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 4px;
    animation: fadeIn 1s ease backwards;
  }

  .quote-speaker {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
    animation: fadeIn 1s ease backwards;
  }

  .quote-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    animation: fadeIn 1s ease backwards;
  }

  .quote-submeta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    animation: fadeIn 1s ease backwards;
  }

  .quote-cta {
    display: inline-block;
    padding: 12px 24px;
    background: var(--accent);
    color: var(--bg-primary) !important;
    font-weight: 600;
    border-radius: 8px;
    transition: background 0.2s ease;
    animation: fadeIn 1s ease backwards;
  }

  .quote-cta:hover {
    background: var(--accent-hover) !important;
  }

  @media (max-width: 640px) {
    .quote-hero {
      padding: 40px 16px;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .quote-hero {
      padding: 60px 20px;
    }
  }

  @media (min-width: 1025px) {
    .quote-hero {
      padding: 80px 20px;
    }
  }

  .no-movie {
    text-align: center;
    padding: 40px;
    background: var(--bg-secondary);
    border-radius: var(--radius);
    color: var(--text-secondary);
  }

  /* 电影库 */
  .movie-library {
    margin-bottom: 60px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .counter {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .movies-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .movies-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1025px) {
    .movies-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
