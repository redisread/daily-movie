---
import Layout from '../../layouts/Layout.astro';
import { movies } from '../../data/movies';

interface Movie {
  id: string;
  title: string;
  titleOriginal?: string;
  year: number;
  rating: number;
  genre: string[];
  duration: number;
  director: { name: string; works?: string };
  cast: { name: string; role: string }[];
  cover: { url: string; bg: string; video?: string };
  publishedDate: string;
  type: string;
  synopsis: string;
  quotes: { text: string; speaker?: string }[];
}

const allMovies: Movie[] = movies as Movie[];

// All unique genres sorted by frequency
const genreCount = new Map<string, number>();
allMovies.forEach(m => m.genre?.forEach(g => genreCount.set(g, (genreCount.get(g) || 0) + 1)));
const allGenres = [...genreCount.entries()].sort((a, b) => b[1] - a[1]).map(([g]) => g);

// Sort by date desc by default
const sorted = [...allMovies].sort((a, b) => b.publishedDate.localeCompare(a.publishedDate));

const moviesJson = JSON.stringify(sorted.map(m => ({
  id: m.id, title: m.title, titleOriginal: m.titleOriginal,
  year: m.year, rating: m.rating, genre: m.genre,
  duration: m.duration, director: m.director, cover: m.cover,
  publishedDate: m.publishedDate, type: m.type, cast: m.cast,
})));

const genresJson = JSON.stringify(allGenres);
---

<Layout title="电影库" activeTab="library">
  <main class="library-page" data-movies={moviesJson} data-genres={genresJson}>
    <header class="page-header">
      <h1>电影库</h1>
      <p class="page-sub">在这里翻阅所有已放映的票根</p>
    </header>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" name="q" id="lib-search" placeholder="按标题、导演、演员搜索..." />
      </div>
      <div class="filter-row">
        <div class="genre-tags" id="genre-tags">
          <button class="genre-tag is-active" data-genre="">全部</button>
          {allGenres.map(g => (
            <button class="genre-tag" data-genre={g}>{g}</button>
          ))}
        </div>
        <select class="sort-select" id="lib-sort">
          <option value="date-desc">最新</option>
          <option value="date-asc">最旧</option>
          <option value="rating-desc">最高分</option>
          <option value="rating-asc">最低分</option>
        </select>
      </div>
    </div>

    <!-- Result count -->
    <p class="result-count" id="result-count">
      共 <strong>{allMovies.length}</strong> 部
    </p>

    <!-- Grid -->
    <div class="lib-grid" id="library-grid">
      {sorted.map((m, idx) => (
        <a href={`/movie/${m.publishedDate}/`} class="lib-card" data-id={m.id}
           data-title={m.title} data-director={m.director?.name}
           data-cast={m.cast?.map(c => c.name).join('///')}
           data-genres={JSON.stringify(m.genre)}
           data-rating={m.rating} data-date={m.publishedDate}
           style={`animation-delay: ${idx * 0.04}s`}>
          <div class="lib-cover" style={`background: ${m.cover?.bg}`}>
            <img src={m.cover?.url} alt={m.title} loading="lazy" onerror="this.src='/fallback-poster.svg'" />
            <span class="lib-rating-badge">{m.rating}</span>
          </div>
          <div class="lib-meta">
            <h3 class="lib-title">{m.title}</h3>
            <span class="lib-year">{m.year}</span>
          </div>
          <div class="lib-tags">
            {(m.genre || []).slice(0, 2).map(g => <span class="lib-genre-pill">{g}</span>)}
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>

<script>
  // ====== Filter / Sort ======
  const grid = document.getElementById('library-grid');
  const resultCount = document.getElementById('result-count');
  const searchInput = document.getElementById('lib-search');
  const genreTags = document.getElementById('genre-tags');
  const sortSelect = document.getElementById('lib-sort');

  let activeGenre = '';
  let sortKey = 'date-desc';

  function applyFilters() {
    if (!grid) return;
    const cards = [...grid.querySelectorAll('.lib-card')] as HTMLElement[];
    const q = (searchInput?.value || '').trim().toLowerCase();

    let visible = 0;
    const sortedCards = cards.filter(card => {
      const title = (card.dataset.title || '').toLowerCase();
      const director = (card.dataset.director || '').toLowerCase();
      const cast = (card.dataset.cast || '').toLowerCase();
      const genres = JSON.parse(card.dataset.genres || '[]') as string[];

      if (q && !title.includes(q) && !director.includes(q) && !cast.includes(q)) return false;
      if (activeGenre && !genres.includes(activeGenre)) return false;
      return true;
    });

    // sort
    sortedCards.sort((a, b) => {
      switch (sortKey) {
        case 'date-desc': return (b.dataset.date || '').localeCompare(a.dataset.date || '');
        case 'date-asc': return (a.dataset.date || '').localeCompare(b.dataset.date || '');
        case 'rating-desc': return Number(b.dataset.rating) - Number(a.dataset.rating);
        case 'rating-asc': return Number(a.dataset.rating) - Number(b.dataset.rating);
        default: return 0;
      }
    });

    // reorder in DOM
    sortedCards.forEach(card => {
      grid.appendChild(card);
      visible++;
    });

    // Hide non-matching
    cards.forEach(card => {
      const isInSorted = sortedCards.includes(card);
      card.style.display = isInSorted ? '' : 'none';
    });

    if (resultCount) {
      resultCount.innerHTML = `共 <strong>${sortedCards.length}</strong> 部`;
    }
  }

  searchInput?.addEventListener('input', applyFilters);

  sortSelect?.addEventListener('change', () => {
    sortKey = sortSelect.value;
    applyFilters();
  });

  genreTags?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.genre-tag') as HTMLElement | null;
    if (!btn) return;
    activeGenre = btn.dataset.genre || '';
    genreTags.querySelectorAll('.genre-tag').forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    applyFilters();
  });
</script>

<style>
  .library-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    font-family: var(--font-body);
  }

  .page-header { margin-bottom: 2.5rem; }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .page-sub {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease;
  }
  .search-box:focus-within {
    border-color: var(--gold);
    box-shadow: 0 0 0 2px var(--gold-soft);
  }
  .search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .search-box input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    font-family: var(--font-body);
    color: var(--text-primary);
    outline: none;
  }
  .search-box input::placeholder { color: var(--text-muted); }

  .filter-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .genre-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .genre-tag {
    padding: 0.4em 1em;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-body);
    white-space: nowrap;
  }
  .genre-tag:hover { color: var(--accent); border-color: var(--accent); }
  .genre-tag.is-active {
    background: var(--accent);
    color: #FFFFFF;
    border-color: var(--accent);
  }

  .sort-select {
    margin-left: auto;
    padding: 0.4em 0.75em;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.85rem;
    font-family: var(--font-body);
    cursor: pointer;
    outline: none;
  }
  .sort-select:focus { border-color: var(--gold); }

  /* Result count */
  .result-count {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .result-count strong { color: var(--accent); font-weight: 700; }

  /* Grid */
  .lib-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
  }

  .lib-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.2s ease;
    animation: libIn 0.5s ease backwards;
  }
  .lib-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--gold);
  }

  @keyframes libIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .lib-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 2/3;
    overflow: hidden;
  }
  .lib-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .lib-card:hover .lib-cover img { transform: scale(1.04); }

  .lib-rating-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 2px 8px;
    background: rgba(0, 0, 0, 0.7);
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .lib-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.75rem 0.75rem 0.25rem;
    gap: 0.5rem;
  }
  .lib-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lib-year {
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .lib-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0 0.75rem 0.75rem;
  }
  .lib-genre-pill {
    font-size: 0.7rem;
    padding: 0.15em 0.55em;
    background: var(--gold-soft);
    color: var(--gold);
    border-radius: 999px;
    border: 1px solid rgba(212, 161, 58, 0.15);
  }

  /* Responsive */
  @media (max-width: 720px) {
    .library-page { padding: 2rem 1rem 3rem; }
    .lib-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }
    .filter-row { flex-direction: column; align-items: stretch; }
    .sort-select { margin-left: 0; }
  }

  @media (max-width: 480px) {
    .lib-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .lib-title { font-size: 0.85rem; }
    .lib-meta { padding: 0.5rem 0.5rem 0.2rem; }
    .lib-tags { padding: 0 0.5rem 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lib-card, .lib-card:hover, .lib-cover img { animation: none; transform: none; transition: none; }
  }
</style>
