---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
---

<Layout title="搜索" activeTab="search">
  <main class="page-container">
    <EmptyState
      title="搜索即将推出"
      description="按影片、导演、演员或台词搜索经典。功能开发中，先来看看今天的票根吧。"
      emoji="🔍"
      ctaText="回首页"
      ctaHref="/"
    />
  </main>
</Layout>

<style>
  .page-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
</style>
