{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local preview only. No production route or real database identifier.
  // Provisioning preview/production resources requires a separate approved change.
  "name": "daily-movie-rebuild-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "WRITES_PAUSED": "0" },
  "secrets": { "required": ["CONTENT_API_KEY"] },
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "daily-movie-preview", "database_id": "00000000-0000-0000-0000-000000000045", "migrations_dir": "migrations" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
