{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Task #65 production release was authorized by the user in #proj-daily-movie msg=5069ce41.
  // This supersedes the earlier Pi-only operator assignment for this Daily Movie release only;
  // other projects and work beyond task #65 retain their own authorization requirements.
  // The production D1 baseline and migration-ledger reconciliation are documented in docs/library-visibility.md.
  "name": "daily-movie",
  "main": "worker/index.ts",
  "triggers": { "crons": ["0 16 * * *"] },
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "daily-movie.jiahongw.com", "custom_domain": true }],
  "vars": { "WRITES_PAUSED": "0" },
  "secrets": { "required": ["CONTENT_API_KEY"] },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-movie-prod",
      "database_id": "38ad8d52-dadd-416d-8e16-e1e299706ddc",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
