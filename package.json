{
  "name": "daily-movie",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4321",
    "dev:api": "wrangler dev --local --port 8787",
    "build": "npm run styles:gen && vite build",
    "preview": "wrangler dev --local --port 4321",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src worker scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:import:local": "tsx scripts/migrate-content.ts --apply-local",
    "db:manifest": "tsx scripts/migrate-content.ts",
    "db:verify:local": "tsx scripts/verify-migration.ts",
    "cf-typegen": "wrangler types --include-runtime false",
    "cf-typegen:check": "wrangler types --include-runtime false --check",
    "test:e2e:server": "npm run build && npm run db:migrate:local && npm run db:import:local && wrangler dev --local --port 4321",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run styles:check && npm run lint && npm run typecheck && npm run cf-typegen:check && npm test && npm run build",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "styles:gen": "tsx scripts/css-modules.ts",
    "styles:check": "tsx scripts/css-modules.ts --check"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "latest",
    "miniflare": "latest",
    "prettier": "^3.9.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "latest",
    "vitest": "^4.1.9",
    "wrangler": "^4.127.1"
  }
}
