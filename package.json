{
  "name": "daily-movie",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "test:e2e:server": "npm run build && astro preview",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --include-runtime false",
    "cf-typegen:check": "wrangler types --include-runtime false --check",
    "verify": "npm run lint && npm run typecheck && npm run cf-typegen:check && npm test && npm audit --omit=dev --audit-level=high && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.2.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^2.0.0",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.127.1"
  }
}
